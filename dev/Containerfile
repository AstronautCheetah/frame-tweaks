# The CI environment as a container, so dev/check.sh runs anywhere Podman or Docker does (a Mac,
# Windows, any Linux): the same base image and packages as .github/workflows/ci.yml, which this
# must follow when CI's change. Built and run by dev/container-check.sh.
FROM docker.io/library/ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive PIP_BREAK_SYSTEM_PACKAGES=1 PIP_ROOT_USER_ACTION=ignore
# (shellcheck, appstream, desktop-file-utils, libarchive-tools: the checks' tools; the libraries
# and xvfb: PyQt6 headless; git, rsync, file, xz, binutils, xdg-user-dirs: what tests call)
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends \
      git ca-certificates python3 python3-pip python3-venv shellcheck rsync procps file \
      appstream desktop-file-utils libarchive-tools xz-utils xdg-user-dirs binutils \
      libegl1 libgl1 libxkbcommon0 libfontconfig1 xvfb libxtst6 libdbus-1-3 \
    && rm -rf /var/lib/apt/lists/*
# (the PyQt6 users get; ruff at CI's version; pyyaml: tests compare the manifest reader with it)
COPY lib/python-constraints.txt /tmp/
RUN python3 -m pip install --quiet ruff==0.17.1 commitizen pyyaml \
    && python3 -m pip install --quiet -c /tmp/python-constraints.txt PyQt6
# (the checkout is mounted from the host, owned by someone else as far as git is concerned)
RUN git config --system --add safe.directory '*'
WORKDIR /src
