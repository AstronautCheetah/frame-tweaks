#!/usr/bin/env bash
# Backstop for the commit-msg hook, which a stray -c core.hooksPath=... or --no-verify skips:
# it refuses a push whose new commits carry an AI attribution trailer (dev/check-trailers.sh).
set -euo pipefail
zero=0000000000000000000000000000000000000000
check="$(git rev-parse --show-toplevel)/dev/check-trailers.sh"
while read -r _lref lsha _rref rsha; do
    [ "$lsha" = "$zero" ] && continue
    if [ "$rsha" = "$zero" ] || ! git cat-file -e "$rsha^{commit}" 2>/dev/null; then
        range=$(git rev-list "$lsha" --not --remotes)
    else
        range=$(git rev-list "$rsha..$lsha")
    fi
    for c in $range; do
        if ! git log -1 --format=%B "$c" | "$check"; then
            echo "pre-push: refusing: commit $(git rev-parse --short "$c") carries an AI attribution trailer (CONTRIBUTING.md)." >&2
            exit 1
        fi
    done
done
