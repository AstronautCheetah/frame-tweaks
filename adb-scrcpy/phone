#!/bin/bash
# Find an Android phone's current wireless-ADB port via mDNS, connect, and mirror it with scrcpy.
# The port changes every time Wireless debugging is toggled, so it's looked up fresh each run.
# Pick a phone by its name in ~/.config/phone.conf:  PHONE_NAME="Pixel 9" (set on first use if
# only one phone is advertising).
# Extra args are passed to scrcpy (e.g. phone --turn-screen-off).
export PATH="$HOME/.local/bin:/home/linuxbrew/.linuxbrew/bin:$PATH"
[ -f "$HOME/.config/phone.conf" ] && . "$HOME/.config/phone.conf"

# find_phone: sets dev=address:port of the advertised phone, or returns 1.
find_phone() {
    all=$(avahi-browse -rtp _adb-tls-connect._tcp 2>/dev/null | grep '^=' | grep ';IPv4;')
    c=$(echo "$all" | grep -F "${PHONE_NAME:-}" | head -1)
    [ -n "$c" ] || return 1
    dev="$(echo "$c" | cut -d';' -f8):$(echo "$c" | cut -d';' -f9)"
}
# Without a PHONE_NAME, don't just take whichever phone advertises first: with one in sight,
# remember it (the next runs connect only to that one); with several, ask which.
if [ -z "${PHONE_NAME:-}" ]; then
    names=$(avahi-browse -rtp _adb-tls-connect._tcp 2>/dev/null | grep '^=' | grep ';IPv4;' |
            sed -n 's/.*"name=\([^"]*\)".*/\1/p' | sort -u)
    if [ "$(printf '%s\n' "$names" | grep -c .)" -gt 1 ]; then
        notify-send -a Phone "Which phone?" "Several are advertising: $(printf '%s' "$names" | paste -sd, - | sed 's/,/, /g'). Set PHONE_NAME=\"…\" in ~/.config/phone.conf."
        exit 1
    fi
    if [ -n "$names" ] && printf '%s' "$names" | grep -qv '["$`\\]'; then
        PHONE_NAME=$names
        printf 'PHONE_NAME="%s"\n' "$PHONE_NAME" >> "$HOME/.config/phone.conf"
        notify-send -a Phone "Android Mirror" "Connecting to $PHONE_NAME from now on (PHONE_NAME in ~/.config/phone.conf)."
    fi
fi
if ! find_phone; then
    # Name the phones that *are* advertising, so a wrong phone or a wrong PHONE_NAME is obvious.
    seen=$(echo "$all" | sed -n 's/.*"name=\([^"]*\)".*/\1/p' | sort -u | paste -sd, - | sed 's/,/, /g')
    msg="Is Wireless debugging on (Developer options, in the phone's Owner profile), on the same Wi-Fi?"
    [ -n "$seen" ] && msg="$msg Seen instead: $seen."
    notify-send -a Phone "${PHONE_NAME:-Phone} not found" "$msg"; exit 1
fi
# With "Memory caps" installed, scrcpy runs inside its memory limit.
cap=(); [ -x "$HOME/.local/bin/capped" ] && cap=("$HOME/.local/bin/capped" scrcpy --)
MAX=1920                                   # the window: fits the Steam session's 1920x1080 screen
# The stream: no larger than VR shows it (the upright window is 1080 tall). scrcpy already shows
# only the newest picture, so a delay is pictures still on their way: the wireless connection
# (TCP, which can't drop a late one) and the phone's encoder. Less data per second, less backlog.
# Set any of these in ~/.config/phone.conf.
STREAM_MAX=${PHONE_MAX_SIZE:-1024} BIT_RATE=${PHONE_BIT_RATE:-2M} MAX_FPS=${PHONE_MAX_FPS:-60}

# A wireless connection can die without scrcpy noticing (the phone changed network or address,
# e.g. after switching profile): the picture just freezes. Check the phone answers every 5 s;
# after 3 misses, close the frozen mirror and reconnect at the phone's current address.
alive() { timeout 4 adb -s "$dev" shell true >/dev/null 2>&1; }
# The mirror's gear panel (in VR) changes the settings above and asks for a restart (SIGUSR1):
# scrcpy starts again, reading ~/.config/phone.conf afresh.
PIDFILE="/run/user/$(id -u)/sft-phone.pid"
echo $$ > "$PIDFILE"
trap '[ "$(cat "$PIDFILE" 2>/dev/null)" = $$ ] && rm -f "$PIDFILE"' EXIT
restart=
trap 'restart=1; kill "$pid" 2>/dev/null' USR1
while :; do
    if [ -n "$restart" ]; then
        restart=
        [ -f "$HOME/.config/phone.conf" ] && . "$HOME/.config/phone.conf"
        STREAM_MAX=${PHONE_MAX_SIZE:-1024} BIT_RATE=${PHONE_BIT_RATE:-2M} MAX_FPS=${PHONE_MAX_FPS:-60}
    fi
    adb connect "$dev" >/dev/null
    # In VR, shape the window like the phone (upright or sideways) and follow its rotation;
    # without it the Steam session makes the window 1920x1080, with black bars beside a portrait
    # phone. (It ends with scrcpy, so it's started again with each reconnect.)
    if [ -x "$HOME/.local/bin/phone-fit" ] && ! pgrep -u "$(id -u)" -f "bin/phone-fit" >/dev/null; then
        setsid -f "$HOME/.local/bin/phone-fit" "$MAX" >/dev/null 2>&1 </dev/null
    fi
    # The Steam session puts laser clicks on so narrow a window at its left edge: phone-touch
    # takes them from a layer over the window instead and sends them to the phone as touches.
    # (Desktop mode or no VR windows helper: it just exits. A reconnect replaces it.)
    if [ -x "$HOME/.local/bin/phone-touch" ] && [ "${DISPLAY:-}" = ":0" ]; then
        setsid -f "$HOME/.local/bin/phone-touch" "$dev" >/dev/null 2>&1 </dev/null
    fi
    # The title is how the dashboard patches recognise the mirror window.
    "${cap[@]}" scrcpy -s "$dev" --video-bit-rate="$BIT_RATE" --max-size="$STREAM_MAX" --max-fps="$MAX_FPS" \
        --window-title="Android Mirror" "$@" &
    pid=$! misses=0
    while kill -0 "$pid" 2>/dev/null; do
        sleep 5 & wait $!                      # (a restart request interrupts the wait)
        [ -n "$restart" ] && break
        if alive; then misses=0; else misses=$((misses + 1)); fi
        [ "$misses" -ge 3 ] && break
    done
    if [ -n "$restart" ]; then
        kill "$pid" 2>/dev/null; wait "$pid" 2>/dev/null
        continue                               # same phone, new settings
    fi
    if ! kill -0 "$pid" 2>/dev/null; then
        wait "$pid"; code=$?
        # Closed by you (or the phone was unplugged/turned off on purpose): done. scrcpy also
        # stops by itself when it notices the connection dropped: reconnect then.
        [ "$code" -eq 0 ] || alive && exit "$code"
    else
        kill "$pid" 2>/dev/null; wait "$pid" 2>/dev/null       # frozen
    fi
    adb disconnect "$dev" >/dev/null 2>&1
    notify-send -a Phone "Phone connection lost" "Reconnecting…"
    found=
    for _ in $(seq 12); do                             # up to a minute
        if find_phone && adb connect "$dev" >/dev/null && alive; then found=1; break; fi
        sleep 5
    done
    if [ -z "$found" ]; then
        notify-send -a Phone "Phone not found" "Is Wireless debugging still on, on the same Wi-Fi? Open Android Mirror again when it is."
        exit 1
    fi
done
