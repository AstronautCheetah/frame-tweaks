{
  "action_manifest_version": 0,
  "controller_type": "frame_controller",
  "name": "Frame Tweaks",
  "description": "B = back, Y = home, A = tick/untick, left D-pad = move between rows",
  "bindings": {
    "/actions/sft": {
      "sources": [
        { "path": "/user/hand/right/input/b", "mode": "button",
          "inputs": { "click": { "output": "/actions/sft/in/back" } } },
        { "path": "/user/hand/right/input/y", "mode": "button",
          "inputs": { "click": { "output": "/actions/sft/in/home" } } },
        { "path": "/user/hand/right/input/a", "mode": "button",
          "inputs": { "click": { "output": "/actions/sft/in/toggle" } } },
        { "path": "/user/hand/left/input/dpad_up", "mode": "button",
          "inputs": { "click": { "output": "/actions/sft/in/up" } } },
        { "path": "/user/hand/left/input/dpad_down", "mode": "button",
          "inputs": { "click": { "output": "/actions/sft/in/down" } } }
      ]
    }
  }
}
