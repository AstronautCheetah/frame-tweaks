#!/usr/bin/env python3
"""wallet-unlock: unlock the shared KDE wallet with a password dialog shown on
the display you're using (the desktop), instead of ksecretd's own prompt, which
pops up as a floating VR window on the Steam session's display.

  wallet-unlock            ask (kdialog) if the wallet is locked; exit 0 when unlocked.
                           Schedules an automatic lock after WALLET_LOCK_HOURS (default 4).
  wallet-unlock --lock     lock it now
  wallet-unlock --status   print locked / unlocked
  wallet-unlock --info     JSON: state, when it was unlocked, when it locks (installer window)
  wallet-unlock --watch    run by wallet-lock-sync.service:
                           - when the wallet is closed (KWalletManager's Close, idle timeout),
                             really lock it (kwalletd6's close leaves ksecretd unlocked);
                           - whenever it gets unlocked, (re)start the auto-lock timer;
                           - replace ksecretd's own password prompt ("KDE Wallet Service",
                             floating in VR; while it's open every other unlock is ignored)
                             with this dialog, on the same display.

It derives the same key KDE's login-time auto-unlock (kwallet-pam) uses,
PBKDF2-SHA512 over the wallet's salt, and hands it to ksecretd's pamOpen on the
outer session bus. The password and key never appear on a command line.
"""
import hashlib
import json
import os
import subprocess
import sys
import time
from pathlib import Path

from jeepney import DBusAddress, MessageType, new_method_call
from jeepney.bus_messages import message_bus
from jeepney.io.blocking import open_dbus_connection

WALLET = "kdewallet"
SALT = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share")) / "kwalletd" / f"{WALLET}.salt"
OUTER_BUS = f"unix:path=/run/user/{os.getuid()}/bus"
SECRETS = DBusAddress("/org/freedesktop/secrets", bus_name="org.freedesktop.secrets",
                      interface="org.freedesktop.Secret.Service")
COLLECTION = f"/org/freedesktop/secrets/collection/{WALLET}"
KSECRETD = DBusAddress("/ksecretd", bus_name="org.kde.ksecretd", interface="org.kde.KWallet")
KWALLETD = DBusAddress("/modules/kwalletd6", bus_name="org.kde.kwalletd6", interface="org.kde.KWallet")
# When the wallet was unlocked and when the auto-lock fires (cleared by locking, and by a reboot).
SESSION = Path(f"/run/user/{os.getuid()}/wallet-session.json")


def bus():
    return open_dbus_connection(OUTER_BUS)


def call(conn, msg):
    reply = conn.send_and_get_reply(msg)
    if reply.header.message_type == MessageType.error:
        raise RuntimeError(f"{reply.header.fields.get(4, 'D-Bus error')}: {reply.body}")
    return reply.body


def ensure_ksecretd(conn):
    """ksecretd holds the wallet; it is D-Bus activatable only as secretservicecompat."""
    if call(conn, message_bus.NameHasOwner("org.kde.ksecretd"))[0]:
        return
    call(conn, message_bus.StartServiceByName("org.kde.secretservicecompat"))
    for _ in range(50):
        if call(conn, message_bus.NameHasOwner("org.kde.ksecretd"))[0]:
            return
        time.sleep(0.1)
    raise RuntimeError("ksecretd did not start")


def is_locked(conn):
    """Locked = ksecretd doesn't have the wallet open. (Not the Secret Service "Locked"
    property: after a pamOpen unlock it still says True, which made every correct password
    look wrong.)"""
    ensure_ksecretd(conn)
    return not ksecretd_open(conn)


def ksecretd_close(conn):
    """Fully close the wallet inside ksecretd. The Secret Service Lock only hides the
    secrets: the wallet stays loaded ("open" and "locked" at once), and then pamOpen
    sees it as already open and does nothing, so every password looks wrong."""
    try:
        call(conn, new_method_call(KSECRETD, "close", "sb", (WALLET, True)))
    except Exception:
        pass


def ksecretd_open(conn):
    try:
        return bool(call(conn, new_method_call(KSECRETD, "isOpen", "s", (WALLET,)))[0])
    except Exception:
        return False


def lock(conn):
    ensure_ksecretd(conn)
    try:
        call(conn, new_method_call(SECRETS, "Lock", "ao", ([COLLECTION],)))
    except Exception:
        pass
    ksecretd_close(conn)
    try:  # kwalletd6 keeps its own open handle on top of ksecretd
        call(conn, new_method_call(KWALLETD, "close", "sb", (WALLET, True)))
    except Exception:
        pass
    SESSION.unlink(missing_ok=True)


def session():
    try:
        return json.loads(SESSION.read_text())
    except (OSError, ValueError):
        return {}


def timer_lock_time():
    """When the running auto-lock timer fires (its start + WALLET_LOCK_HOURS), else None."""
    env = dict(os.environ, XDG_RUNTIME_DIR=f"/run/user/{os.getuid()}", DBUS_SESSION_BUS_ADDRESS=OUTER_BUS)
    r = subprocess.run(["systemctl", "--user", "show", "--timestamp=unix", "-p", "ActiveEnterTimestamp",
                        "-p", "ActiveState", "wallet-autolock.timer"], env=env, capture_output=True, text=True)
    props = dict(line.split("=", 1) for line in r.stdout.splitlines() if "=" in line)
    started = props.get("ActiveEnterTimestamp", "").lstrip("@")
    if props.get("ActiveState") != "active" or not started.isdigit():
        return None
    return int(started) + float(os.environ.get("WALLET_LOCK_HOURS", "4")) * 3600


def idle_close_minutes():
    """kwalletd also closes (we then lock) the wallet after this long unused, if enabled."""
    conf = Path.home() / ".config/kwalletrc"
    text = conf.read_text() if conf.exists() else ""
    group = text.split("[Wallet]", 1)[1].split("\n[", 1)[0] if "[Wallet]" in text else ""
    if "Close When Idle=true" not in group:
        return None
    for line in group.splitlines():
        if line.startswith("Idle Timeout="):
            try:
                return int(line.split("=", 1)[1])
            except ValueError:
                return None
    return None


def x_env(display):
    """Environment to reach an X display; the desktop's :2 needs its XAUTHORITY."""
    env = dict(os.environ, DISPLAY=display)
    if display != ":0":
        src = subprocess.run(["pgrep", "-u", str(os.getuid()), "-x", "ksmserver"],
                             capture_output=True, text=True).stdout.split()
        if src:
            try:
                senv = dict(kv.split("=", 1) for kv in
                            Path(f"/proc/{src[0]}/environ").read_text().split("\0") if "=" in kv)
                env["DISPLAY"] = senv.get("DISPLAY", display)
                if "XAUTHORITY" in senv:
                    env["XAUTHORITY"] = senv["XAUTHORITY"]
            except OSError:
                pass
    return env


def ksecretd_prompts():
    """[(display, window id)] of visible ksecretd dialogs: the "bad" route. (Ours are
    titled "Unlock wallet", class kdialog.)"""
    found = []
    for display in (":0", ":2"):
        env = x_env(display)
        try:
            tree = subprocess.run(["xwininfo", "-root", "-tree"], env=env, capture_output=True,
                                  text=True, timeout=3).stdout
        except (OSError, subprocess.SubprocessError):
            continue
        for line in tree.splitlines():
            if '"KDE Wallet Service": ("ksecretd"' not in line:
                continue
            wid = line.split()[0]
            info = subprocess.run(["xwininfo", "-id", wid], env=env, capture_output=True, text=True).stdout
            if "IsViewable" in info and "Width: 1\n" not in info:
                found.append((env["DISPLAY"], int(wid, 16)))
    return found


def close_window(display, wid):
    """Ask a window to close, like its ✕ button (WM_DELETE_WINDOW); ksecretd treats it as
    Cancel. Plain Xlib through ctypes: no xdotool on SteamOS."""
    import ctypes as C

    class ClientMessage(C.Structure):
        _fields_ = [("type", C.c_int), ("serial", C.c_ulong), ("send_event", C.c_int),
                    ("display", C.c_void_p), ("window", C.c_ulong), ("message_type", C.c_ulong),
                    ("format", C.c_int), ("data", C.c_long * 5), ("pad", C.c_long * 24)]
    xlib = C.cdll.LoadLibrary("libX11.so.6")
    xlib.XOpenDisplay.restype = C.c_void_p
    xlib.XInternAtom.restype = C.c_ulong
    xlib.XInternAtom.argtypes = [C.c_void_p, C.c_char_p, C.c_int]
    xlib.XSendEvent.argtypes = [C.c_void_p, C.c_ulong, C.c_int, C.c_long, C.c_void_p]
    old = os.environ.get("XAUTHORITY")
    env = x_env(display)
    if "XAUTHORITY" in env:
        os.environ["XAUTHORITY"] = env["XAUTHORITY"]
    dpy = xlib.XOpenDisplay(display.encode())
    if old is not None:
        os.environ["XAUTHORITY"] = old
    if not dpy:
        return False
    ev = ClientMessage(type=33, window=wid, format=32,                      # 33 = ClientMessage
                       message_type=xlib.XInternAtom(dpy, b"WM_PROTOCOLS", False))
    ev.data[0] = xlib.XInternAtom(dpy, b"WM_DELETE_WINDOW", False)
    ev.data[1] = 0                                                           # CurrentTime
    xlib.XSendEvent(dpy, wid, False, 0, C.byref(ev))
    xlib.XFlush(C.c_void_p(dpy))
    xlib.XCloseDisplay(C.c_void_p(dpy))
    return True


def prompt_pending():
    """True if one of ksecretd's own password prompts is showing (VR display :0 or the
    desktop). While it is, ksecretd ignores pamOpen, so a right password looks wrong."""
    for display in (":0", os.environ.get("DISPLAY", ":2")):
        try:
            tree = subprocess.run(["xwininfo", "-root", "-tree"], env=dict(os.environ, DISPLAY=display),
                                  capture_output=True, text=True, timeout=3).stdout
        except (OSError, subprocess.SubprocessError):
            continue
        for line in tree.splitlines():
            if '"KDE Wallet Service": ("ksecretd"' in line:
                wid = line.split()[0]
                info = subprocess.run(["xwininfo", "-id", wid], env=dict(os.environ, DISPLAY=display),
                                      capture_output=True, text=True).stdout
                if "IsViewable" in info:
                    return True
    return False


def ask_password(retry):
    text = ("Wrong password (is Caps Lock on?). Try again:" if retry
            else "Password for the KDE wallet:")
    r = subprocess.run(["kdialog", "--title", "Unlock wallet", "--password", text],
                       capture_output=True, text=True)
    return None if r.returncode else r.stdout.rstrip("\n")


def unlock(conn):
    ensure_ksecretd(conn)
    if ksecretd_open(conn):          # stuck "open but locked": pamOpen would be ignored
        ksecretd_close(conn)
    salt = SALT.read_bytes()
    for attempt in range(3):
        pw = ask_password(attempt > 0)
        if pw is None:
            return False
        key = hashlib.pbkdf2_hmac("sha512", pw.encode(), salt, 50000, 56)
        del pw
        conn.send(new_method_call(KSECRETD, "pamOpen", "sayi", (WALLET, key, 0)))
        for _ in range(20):            # pamOpen has no reply; poll the result
            time.sleep(0.1)
            if not is_locked(conn):
                return True
        if prompt_pending():
            subprocess.run(["kdialog", "--title", "Unlock wallet", "--sorry",
                            "A KDE Wallet password prompt is already open (look in VR, around the "
                            "dashboard). While it is open the wallet ignores this dialog.\n\n"
                            "Type the password there, or close that prompt and try again."])
            return False
    return False


def schedule_lock():
    """(Re)start a transient systemd timer that locks the wallet later."""
    hours = os.environ.get("WALLET_LOCK_HOURS", "4")
    env = dict(os.environ, XDG_RUNTIME_DIR=f"/run/user/{os.getuid()}",
               DBUS_SESSION_BUS_ADDRESS=OUTER_BUS)
    # Clear the previous timer *and* its service: a failed earlier run left a unit with this name
    # behind, and systemd-run then refused the name, silently, so nothing locked the wallet.
    for cmd in (["stop", "wallet-autolock.timer", "wallet-autolock.service"],
                ["reset-failed", "wallet-autolock.timer", "wallet-autolock.service"]):
        subprocess.run(["systemctl", "--user", *cmd], env=env, stderr=subprocess.DEVNULL)
    r = subprocess.run(["systemd-run", "--user", "--quiet", "--unit=wallet-autolock",
                        f"--on-active={hours}h", os.path.abspath(sys.argv[0]), "--lock"],
                       env=env, capture_output=True, text=True)
    if r.returncode != 0:
        print(f"wallet-unlock: couldn't schedule the auto-lock: {r.stderr.strip()}", file=sys.stderr, flush=True)
        return "?"
    s = session()
    now = time.time()
    s.setdefault("unlocked", now)         # an app reopening the open wallet only moves the lock
    try:
        s["locks"] = now + float(hours) * 3600
    except ValueError:
        s.pop("locks", None)
    try:
        SESSION.write_text(json.dumps(s))
    except OSError:
        pass
    return hours


def watch():
    """kwalletd6 'closing' a wallet leaves ksecretd unlocked, so apps keep reading
    secrets. Turn every close into a real lock."""
    from jeepney import MatchRule
    from jeepney.bus_messages import message_bus as mb
    import threading
    threading.Thread(target=broker, daemon=True).start()
    with bus() as conn:
        for member in ("walletClosed", "allWalletsClosed", "walletOpened"):
            rule = MatchRule(type="signal", interface="org.kde.KWallet", member=member)
            call(conn, mb.AddMatch(rule))
        while True:
            msg = conn.receive()
            if msg.header.message_type != MessageType.signal:
                continue
            member = msg.header.fields.get(3)          # 3 = MEMBER
            body = msg.body
            if member == "walletOpened" and body and body[0] == WALLET:
                # Unlocked by any route: the 4-hour auto-lock counts from now.
                print(f"{time.strftime('%T')} wallet opened -> auto-lock in {schedule_lock()} h", flush=True)
                continue
            if member == "allWalletsClosed" or (member == "walletClosed" and body and body[0] == WALLET):
                try:
                    if not is_locked(conn) or ksecretd_open(conn):
                        lock(conn)
                        print(f"{time.strftime('%T')} wallet closed -> locked and closed in ksecretd", flush=True)
                except Exception as e:                  # keep watching even if one lock fails
                    print(f"lock failed: {e}", flush=True)


def broker():
    """Replace ksecretd's own password prompt with ours. Only while the wallet is locked:
    a ksecretd window on an unlocked wallet is an "allow this app?" question, left alone."""
    exe = os.path.abspath(sys.argv[0])
    while True:
        time.sleep(1.5)
        try:
            prompts = ksecretd_prompts()
            if not prompts:
                continue
            with bus() as conn:
                if not is_locked(conn):
                    continue
            for display, wid in prompts:
                close_window(display, wid)
                print(f"{time.strftime('%T')} closed ksecretd's prompt on {display}; showing ours", flush=True)
            time.sleep(0.5)
            env = x_env(prompts[0][0])
            env.pop("WAYLAND_DISPLAY", None)          # kdialog on that X display
            env["QT_QPA_PLATFORM"] = "xcb"
            subprocess.run([exe], env=env)              # our dialog; unlocks on success
        except Exception as e:                          # keep brokering whatever happens
            print(f"broker: {e}", flush=True)


def notify(text):
    subprocess.run(["notify-send", "-a", "Wallet", text], stderr=subprocess.DEVNULL)


def main():
    arg = sys.argv[1] if len(sys.argv) > 1 else ""
    if arg == "--watch":
        watch()
        return
    with bus() as conn:
        if arg == "--status":
            print("locked" if is_locked(conn) else "unlocked")
        elif arg == "--info":
            locked = is_locked(conn)
            s = {} if locked else session()
            if not locked and "locks" not in s:     # unlocked before times were recorded
                s["locks"] = timer_lock_time()
            print(json.dumps({"state": "locked" if locked else "unlocked", "unlocked_at": s.get("unlocked"),
                              "locks_at": s.get("locks"), "idle_close_minutes": idle_close_minutes()}))
        elif arg == "--lock":
            lock(conn)
            if not is_locked(conn):
                sys.exit("wallet-unlock: the wallet is still unlocked (locking failed)")
            print("locked")
        elif arg == "--watch":
            pass
        elif arg == "--schedule-lock":
            print(f"wallet locks in {schedule_lock()} h")
        elif arg:
            sys.exit(__doc__)
        elif not is_locked(conn):
            print("Wallet already unlocked.")
        elif unlock(conn):
            hours = schedule_lock()
            print(f"Wallet unlocked; it locks again in {hours} h.")
            notify(f"Wallet unlocked for {hours} hours")
        else:
            print("Wallet still locked.", file=sys.stderr)
            sys.exit(1)


if __name__ == "__main__":
    main()
