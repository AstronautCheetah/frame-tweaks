#!/usr/bin/env python3
"""nordvpn-tray: system tray icon for the nordvpn-wg connections, because SteamOS on the
Frame ships no Plasma network applet. Left- or right-click the icon for a menu of
locations (the status is re-read each time it opens); the icon turns green while
connected."""
import os
import subprocess
import sys

# Under native Wayland a parentless popup menu can't be positioned; XWayland can.
os.environ.setdefault("QT_QPA_PLATFORM", "xcb")

from PyQt6.QtCore import QProcess, Qt, QTimer  # noqa: E402
from PyQt6.QtCore import QPoint  # noqa: E402
from PyQt6.QtGui import QAction, QActionGroup, QColor, QIcon, QPainter, QPixmap  # noqa: E402
from PyQt6.QtWidgets import QApplication, QMenu, QSystemTrayIcon  # noqa: E402

NWG = os.path.expanduser("~/.local/bin/nordvpn-wg")
PREFIX = "nordvpn-"


def icon(color):
    """A simple shield-ish dot, so we don't depend on the icon theme."""
    pm = QPixmap(64, 64)
    pm.fill(Qt.GlobalColor.transparent)
    p = QPainter(pm)
    p.setRenderHint(QPainter.RenderHint.Antialiasing)
    p.setBrush(QColor(color))
    p.setPen(QColor("#202020"))
    p.drawRoundedRect(8, 6, 48, 52, 14, 14)
    p.setPen(QColor("white"))
    f = p.font()
    f.setPixelSize(26)
    f.setBold(True)
    p.setFont(f)
    p.drawText(pm.rect(), Qt.AlignmentFlag.AlignCenter, "N")
    p.end()
    return QIcon(pm)


def panel_anchor():
    """(edge, thickness, screen width, screen height) of Plasma's first panel, so the
    left-click menu can open next to the tray. (XWayland can't see the pointer while it
    is over the Wayland panel, so QCursor.pos() would be stale.)"""
    script = ('var p=panels()[0]; var g=screenGeometry(p.screen);'
              'print(p.location+" "+p.height+" "+g.width+" "+g.height)')
    try:
        out = subprocess.run(["qdbus6", "org.kde.plasmashell", "/PlasmaShell",
                              "org.kde.PlasmaShell.evaluateScript", script],
                             capture_output=True, text=True, timeout=5).stdout.split()
        return out[0], int(out[1]), int(out[2]), int(out[3])
    except Exception:
        return "bottom", 48, 0, 0


def nm_connections():
    """[(name, iface)] for our WireGuard profiles, and the active iface (or None)."""
    out = subprocess.run(["nmcli", "-t", "-f", "NAME,TYPE,DEVICE", "connection", "show"],
                         capture_output=True, text=True).stdout
    profiles, active = [], None
    for line in out.splitlines():
        parts = line.replace("\\:", "\0").split(":")
        if len(parts) < 3 or parts[1] != "wireguard":
            continue
        name = parts[0].replace("\0", ":")
        if not name.startswith("NordVPN "):
            continue
        profiles.append(name)
        if parts[2].startswith(PREFIX):
            active = name
    return sorted(profiles), active


class Tray:
    def __init__(self, app):
        self.app = app
        self.on, self.off, self.busy = icon("#2e9d4f"), icon("#7a7a7a"), icon("#d9a400")
        self.tray = QSystemTrayIcon(self.off)
        self.menu = QMenu()
        self.tray.setContextMenu(self.menu)
        self.tray.activated.connect(self.on_activated)
        # Re-read the connection state whenever the menu opens (right-click included).
        self.menu.aboutToShow.connect(self.refresh)
        self.proc = None
        self.active = None
        self.profiles = []
        self.anchor = panel_anchor()
        self.refresh()
        self.tray.show()
        QTimer(app, interval=5000, timeout=self.poll).start()

    def poll(self):
        """Periodic update: icon/tooltip always, menu only while it's closed
        (rebuilding an open menu would close it)."""
        self.update_state()
        if not self.menu.isVisible():
            self.build_menu()

    def menu_pos(self):
        edge, thick, w, h = self.anchor
        if not w:
            w, h = self.app.primaryScreen().size().width(), self.app.primaryScreen().size().height()
        size = self.menu.sizeHint()
        x = w - size.width() - 8
        y = thick + 4 if edge == "top" else h - thick - size.height() - 4
        if edge == "left":
            x, y = thick + 4, h - size.height() - 8
        elif edge == "right":
            x, y = w - thick - size.width() - 4, h - size.height() - 8
        return QPoint(max(0, x), max(0, y))

    def on_activated(self, reason):
        if reason == QSystemTrayIcon.ActivationReason.Trigger:   # left click: same menu
            self.refresh()
            self.menu.popup(self.menu_pos())

    def run(self, *args, note=None):
        if self.proc and self.proc.state() != QProcess.ProcessState.NotRunning:
            return
        self.tray.setIcon(self.busy)
        self.proc = QProcess()
        self.proc.finished.connect(lambda *_: self.done(note))
        self.proc.start(NWG, list(args))

    def done(self, note):
        out = bytes(self.proc.readAllStandardOutput()).decode().strip()
        err = bytes(self.proc.readAllStandardError()).decode().strip()
        self.refresh()
        msg = err or (note and out) or ""
        if msg:
            self.tray.showMessage("NordVPN", msg[-300:], self.on if self.active else self.off, 6000)

    def refresh(self):
        self.update_state()
        self.build_menu()

    def update_state(self):
        self.profiles, self.active = nm_connections()
        busy = self.proc and self.proc.state() != QProcess.ProcessState.NotRunning
        self.tray.setIcon(self.busy if busy else self.on if self.active else self.off)
        self.tray.setToolTip(f"NordVPN: {self.active[8:] if self.active else 'disconnected'}")

    def build_menu(self):
        profiles = self.profiles
        self.menu.clear()
        head = self.menu.addAction(f"Connected: {self.active[8:]}" if self.active else "Disconnected")
        head.setEnabled(False)
        self.menu.addSeparator()
        group = QActionGroup(self.menu)
        for name in profiles:
            a = QAction(name[8:], self.menu, checkable=True, checked=(name == self.active))
            code = self.code_for(name)
            a.triggered.connect(lambda _=False, c=code: self.run("up", c))
            group.addAction(a)
            self.menu.addAction(a)
        if not profiles:
            self.menu.addAction("No locations: run 'nordvpn-wg setup'").setEnabled(False)
        self.menu.addSeparator()
        dis = self.menu.addAction("Disconnect")
        dis.setEnabled(bool(self.active))
        dis.triggered.connect(lambda: self.run("down"))
        self.menu.addAction("Show public IP").triggered.connect(lambda: self.run("status", note=True))
        self.menu.addAction("Pick least-loaded servers").triggered.connect(
            lambda: self.run("refresh", note=True))
        self.menu.addSeparator()
        self.menu.addAction("Quit tray icon").triggered.connect(self.app.quit)

    _codes = {}

    def code_for(self, name):
        if name in self._codes:
            return self._codes[name]
        iface = subprocess.run(["nmcli", "-g", "connection.interface-name", "connection", "show", name],
                               capture_output=True, text=True).stdout.strip()
        self._codes[name] = iface[len(PREFIX):].upper()
        return self._codes[name]


def main():
    app = QApplication(sys.argv)
    app.setApplicationName("nordvpn-tray")
    app.setQuitOnLastWindowClosed(False)
    if not QSystemTrayIcon.isSystemTrayAvailable():
        sys.exit("nordvpn-tray: no system tray available")
    Tray(app)
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
