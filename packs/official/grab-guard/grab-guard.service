[Unit]
Description=Warn when desktop mode grabs all input (grab-guard, Frame Tweaks)

[Service]
ExecStart=%h/.local/bin/grab-guard --run
Restart=on-failure
RestartSec=5
# Reads input devices and the Steam session's window titles, writes its log, shows a notification.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=%t %h/.local/state/frame-tweaks
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
SystemCallArchitectures=native

[Install]
WantedBy=default.target
