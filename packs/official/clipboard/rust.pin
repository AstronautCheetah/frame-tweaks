# The Rust toolchain clipboard-sync is built with: rustup-init (pinned, checked against this
# hash) installs this exact toolchain into a temporary folder that's deleted after the build
# (rustup checks each download against the checksums in the channel's manifest, over HTTPS).
# Bump by hand after reading the release notes: version/url/sha256 (rustup) and toolchain
# together. dev/check-pins.sh reports newer ones.
version=1.29.1
url=https://static.rust-lang.org/rustup/archive/1.29.1/aarch64-unknown-linux-gnu/rustup-init
sha256=15f6e4ce9f583b929c996c91562bad6d4454f3281de858b02cdfdef615fac433
toolchain=1.99.0
latest=https://static.rust-lang.org/rustup/release-stable.toml
mirror=https://github.com/AstronautCheetah/frame-tweaks/releases/download/mirror/15f6e4ce9f58-rustup-init
license=Apache-2.0 or MIT (rustup)
