# ---- capture ------------------------------------------------------------------------------
class XImage(ctypes.Structure):
    _fields_ = [("width", ctypes.c_int), ("height", ctypes.c_int), ("xoffset", ctypes.c_int),
                ("format", ctypes.c_int), ("data", ctypes.c_void_p), ("byte_order", ctypes.c_int),
                ("bitmap_unit", ctypes.c_int), ("bitmap_bit_order", ctypes.c_int), ("bitmap_pad", ctypes.c_int),
                ("depth", ctypes.c_int), ("bytes_per_line", ctypes.c_int), ("bits_per_pixel", ctypes.c_int)]


class Attrs(ctypes.Structure):
    _fields_ = [("x", ctypes.c_int), ("y", ctypes.c_int), ("width", ctypes.c_int), ("height", ctypes.c_int),
                ("rest", ctypes.c_char * 256)]


def capture_focused():
    """The focused window of the Steam session (gamescope's GAMESCOPE_FOCUSED_WINDOW) as a QImage."""
    x = ctypes.cdll.LoadLibrary(ctypes.util.find_library("X11") or "libX11.so.6")
    x.XOpenDisplay.restype = ctypes.c_void_p
    x.XGetImage.restype = ctypes.c_void_p
    x.XInternAtom.restype = ctypes.c_ulong
    x.XDefaultRootWindow.restype = ctypes.c_ulong
    d = ctypes.c_void_p(x.XOpenDisplay(b":0"))
    if not d.value:
        raise RuntimeError("can't open the Steam session's display")
    root = ctypes.c_ulong(x.XDefaultRootWindow(d))
    atom = x.XInternAtom(d, b"GAMESCOPE_FOCUSED_WINDOW", 1)
    rtype, fmt, n, after = ctypes.c_ulong(), ctypes.c_int(), ctypes.c_ulong(), ctypes.c_ulong()
    prop = ctypes.c_void_p()
    if not atom or x.XGetWindowProperty(d, root, ctypes.c_ulong(atom), 0, 1, 0, ctypes.c_ulong(6),   # XA_CARDINAL
                                        ctypes.byref(rtype), ctypes.byref(fmt), ctypes.byref(n),
                                        ctypes.byref(after), ctypes.byref(prop)) != 0 or not n.value:
        raise RuntimeError("no focused window")
    win = ctypes.c_ulong(ctypes.cast(prop, ctypes.POINTER(ctypes.c_ulong))[0])
    x.XFree(prop)
    a = Attrs()
    x.XGetWindowAttributes(d, win, ctypes.byref(a))
    img = x.XGetImage(d, win, 0, 0, a.width, a.height, ctypes.c_ulong(0xFFFFFFFF), 2)        # ZPixmap
    if not img:
        raise RuntimeError("couldn't read the window's picture")
    xi = XImage.from_address(img)
    data = ctypes.string_at(xi.data, xi.bytes_per_line * xi.height)
    q = QImage(data, xi.width, xi.height, xi.bytes_per_line, QImage.Format.Format_RGB32).copy()
    return q                                   # (the X image is freed when this short-lived tool exits)


# ---- actions ------------------------------------------------------------------------------
def nested_wayland():
    """The desktop's Wayland socket (wl-copy talks to it from any session)."""
    for s in [RUN / "nested_plasma/wayland-0", *RUN.glob("*/wayland-0"), RUN / "wayland-0"]:
        if s.is_socket():
            return str(s)
    return None


def wl_tool(name):
    """wl-copy / wl-paste: on PATH, or Homebrew's (not always on a launcher's PATH)."""
    return shutil.which(name) or next((p for p in ("/home/linuxbrew/.linuxbrew/bin/" + name,) if os.path.exists(p)), None)


def to_clipboard(data, mime):
    sock = nested_wayland()
    if not sock or not wl_tool("wl-copy"):
        return False
    env = dict(os.environ, WAYLAND_DISPLAY=sock)
    p = subprocess.Popen([wl_tool("wl-copy"), "--type", mime], stdin=subprocess.PIPE, env=env, start_new_session=True)
    p.communicate(data)
    return p.returncode == 0


def breeze(name):
    """A Breeze icon (largest SVG), or an empty icon."""
    hits = sorted(Path("/usr/share/icons/breeze-dark").glob(f"*/*/{name}.svg"))
    return QIcon(str(hits[-1])) if hits else QIcon()


def x_clipboard_owner(folder):
    """frame-snip --x-clipboard DIR: own the desktop's X clipboard (:2) and offer the files in DIR
    (clip.png, clip.bmp, clip.html) as image/png, image/bmp and text/html, until something else is
    copied. Some apps (OnlyOffice) don't take an image offered as PNG alone, which is all wl-copy
    can do; KWin passes the X clipboard on to Wayland apps too. No focus needed, unlike Wayland."""
    folder = Path(folder)
    files = {"image/png": "clip.png", "image/bmp": "clip.bmp", "text/html": "clip.html"}
    data = {k: (folder / v).read_bytes() for k, v in files.items() if (folder / v).exists()}
    shutil.rmtree(folder, ignore_errors=True)
    auth = next(iter(sorted(RUN.glob("nested_plasma/xauth_*"))), None)
    if auth:
        os.environ["XAUTHORITY"] = str(auth)
    x = ctypes.cdll.LoadLibrary(ctypes.util.find_library("X11") or "libX11.so.6")
    x.XOpenDisplay.restype = ctypes.c_void_p
    x.XInternAtom.restype = ctypes.c_ulong
    x.XCreateSimpleWindow.restype = ctypes.c_ulong
    x.XDefaultRootWindow.restype = ctypes.c_ulong
    x.XGetSelectionOwner.restype = ctypes.c_ulong
    d = ctypes.c_void_p(x.XOpenDisplay(b":2"))
    if not d.value:
        return 1
    atom = lambda n: x.XInternAtom(d, n.encode(), 0)
    win = x.XCreateSimpleWindow(d, ctypes.c_ulong(x.XDefaultRootWindow(d)), 0, 0, 1, 1, 0, 0, 0)
    CLIP, TARGETS, TIMESTAMP, XA_ATOM, XA_INTEGER = atom("CLIPBOARD"), atom("TARGETS"), atom("TIMESTAMP"), 4, 19
    offers = {atom(k): v for k, v in data.items()}
    x.XSetSelectionOwner(d, ctypes.c_ulong(CLIP), ctypes.c_ulong(win), ctypes.c_ulong(0))
    if x.XGetSelectionOwner(d, ctypes.c_ulong(CLIP)) != win:
        return 1

    class Req(ctypes.Structure):                      # XSelectionRequestEvent
        _fields_ = [("type", ctypes.c_int), ("serial", ctypes.c_ulong), ("send_event", ctypes.c_int),
                    ("display", ctypes.c_void_p), ("owner", ctypes.c_ulong), ("requestor", ctypes.c_ulong),
                    ("selection", ctypes.c_ulong), ("target", ctypes.c_ulong), ("property", ctypes.c_ulong),
                    ("time", ctypes.c_ulong)]

    class Note(ctypes.Structure):                     # XSelectionEvent
        _fields_ = [("type", ctypes.c_int), ("serial", ctypes.c_ulong), ("send_event", ctypes.c_int),
                    ("display", ctypes.c_void_p), ("requestor", ctypes.c_ulong), ("selection", ctypes.c_ulong),
                    ("target", ctypes.c_ulong), ("property", ctypes.c_ulong), ("time", ctypes.c_ulong),
                    ("pad", ctypes.c_char * 64)]

    ev = (ctypes.c_char * 256)()
    while True:
        x.XNextEvent(d, ev)
        etype = ctypes.c_int.from_buffer(ev).value
        if etype == 29:                               # SelectionClear: something else was copied
            return 0
        if etype != 30:                               # SelectionRequest
            continue
        r = Req.from_buffer(ev)
        prop = r.property or r.target
        if r.target == TARGETS:
            atoms = (ctypes.c_ulong * (len(offers) + 2))(TARGETS, TIMESTAMP, *offers)
            x.XChangeProperty(d, ctypes.c_ulong(r.requestor), ctypes.c_ulong(prop), ctypes.c_ulong(XA_ATOM),
                              32, 0, atoms, len(atoms))
        elif r.target == TIMESTAMP:
            t = (ctypes.c_ulong * 1)(0)
            x.XChangeProperty(d, ctypes.c_ulong(r.requestor), ctypes.c_ulong(prop), ctypes.c_ulong(XA_INTEGER), 32, 0, t, 1)
        elif r.target in offers:
            blob = offers[r.target]
            x.XChangeProperty(d, ctypes.c_ulong(r.requestor), ctypes.c_ulong(prop), ctypes.c_ulong(r.target),
                              8, 0, ctypes.c_char_p(blob), len(blob))
        else:
            prop = 0                                  # can't give that
        note = Note(type=31, send_event=1, display=d, requestor=r.requestor, selection=r.selection,
                    target=r.target, property=prop, time=r.time)
        x.XSendEvent(d, ctypes.c_ulong(r.requestor), 0, 0, ctypes.byref(note))
        x.XFlush(d)


def copy_image_everywhere(image):
    """Put an image on the clipboard in the formats apps look for (PNG, BMP, an HTML <img>), via an
    X clipboard owner on the desktop; plain wl-copy (PNG only) if that can't start."""
    from PyQt6.QtCore import QBuffer, QByteArray, QIODevice
    import base64
    def encoded(fmt):
        buf = QByteArray()
        b = QBuffer(buf)
        b.open(QIODevice.OpenModeFlag.WriteOnly)
        image.save(b, fmt)
        return bytes(buf)
    png = encoded("PNG")
    if not list(RUN.glob("nested_plasma/xauth_*")):
        return to_clipboard(png, "image/png")
    d = Path(tempfile.mkdtemp(prefix="snip-clip-"))
    (d / "clip.png").write_bytes(png)
    (d / "clip.bmp").write_bytes(encoded("BMP"))
    (d / "clip.html").write_bytes(f'<img src="data:image/png;base64,{base64.b64encode(png).decode()}">'.encode())
    subprocess.Popen([sys.executable, os.path.abspath(sys.argv[0]), "--x-clipboard", str(d)], start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return True


def from_clipboard():
    """The desktop clipboard's text (wl-paste), or None."""
    sock = nested_wayland()
    if not sock or not wl_tool("wl-paste"):
        return None
    r = subprocess.run([wl_tool("wl-paste"), "--no-newline", "--type", "text"], capture_output=True,
                       env=dict(os.environ, WAYLAND_DISPLAY=sock), timeout=5)
    text = r.stdout.decode(errors="replace").strip() if r.returncode == 0 else ""
    return text or None


def notify(title, body=""):
    subprocess.run(["notify-send", "-a", "Screen snip", title, body[:300]], stderr=subprocess.DEVNULL)


def ocr(img):
    """Text in the image (Tesseract), or None if Tesseract isn't installed."""
    if not Path(TESSERACT).exists():
        return None
    with tempfile.TemporaryDirectory() as t:
        path = Path(t) / "snip.png"
        # Small screen text reads better at 2x.
        img.scaled(img.width() * 2, img.height() * 2, Qt.AspectRatioMode.KeepAspectRatio,
                   Qt.TransformationMode.SmoothTransformation).save(str(path))
        r = subprocess.run([TESSERACT, str(path), "-", "--psm", "3"], capture_output=True, text=True)
    text = re.sub(r"[ \t]+\n", "\n", r.stdout).strip()
    return re.sub(r"\n{3,}", "\n\n", text)


# ---- narration ------------------------------------------------------------------------------
SETTINGS = HOME / ".config/frame-tweaks/snip.json"
SPEEDS = [0.75, 1.0, 1.25, 1.5, 1.75, 2.0]


def load_speed():
    try:
        v = float(json.loads(SETTINGS.read_text()).get("speed", 1.0))
    except (OSError, ValueError, AttributeError):
        v = 1.0
    return min(SPEEDS, key=lambda x: abs(x - v))


def save_speed(v):
    try:
        conf = json.loads(SETTINGS.read_text()) if SETTINGS.exists() else {}
    except (OSError, ValueError):
        conf = {}
    conf["speed"] = v
    SETTINGS.parent.mkdir(parents=True, exist_ok=True)
    SETTINGS.write_text(json.dumps(conf) + "\n")


def sentences(text):
    """Speakable chunks: sentences, long ones split at commas, short ones joined."""
    parts = [p.strip() for p in re.split(r"(?<=[.!?:;])\s+|\n{2,}", text.replace("\r", "")) if p.strip()]
    out = []
    for part in parts:
        part = re.sub(r"\s+", " ", part)
        while len(part) > 300:                              # very long: break at a comma or space
            cut = max(part.rfind(", ", 0, 300), part.rfind(" ", 0, 300))
            cut = cut if cut > 100 else 300
            out.append(part[:cut + 1].strip())
            part = part[cut + 1:].strip()
        if out and len(out[-1]) < 40:
            out[-1] = f"{out[-1]} {part}"
        else:
            out.append(part)
    return out


class Narrator(QObject):
    """Reads text aloud with Piper, a sentence at a time (the next one is prepared while one plays),
    so it starts quickly and a speed change applies at once (the current sentence restarts)."""
    progress = pyqtSignal(int, int)          # sentence index, count
    finished = pyqtSignal()

    def __init__(self, text, speed):
        super().__init__()
        self.parts, self.speed = sentences(text), speed
        self.dir = Path(tempfile.mkdtemp(prefix="snip-narrate-"))
        self.wavs = {}                       # index -> (speed, path) synthesized
        self.synth = None                    # (index, speed, QProcess) being synthesized
        self.player = None
        self.i = 0
        self.stopped = False
        self.paused = False

    def start(self):
        self._synth(self.i)

    def _synth(self, i):
        if i >= len(self.parts) or self.synth or (i in self.wavs and self.wavs[i][0] == self.speed):
            return
        out = self.dir / f"{i}-{self.speed}.wav"
        proc = QProcess(self)
        speed = self.speed
        proc.finished.connect(lambda *_: self._synthesized(i, speed, out, proc))
        proc.start(str(PIPER), ["--model", str(VOICE), "--config", f"{VOICE}.json", "--output_file", str(out),
                                "--length_scale", f"{1 / speed:.3f}"])
        proc.write(self.parts[i].encode())
        proc.closeWriteChannel()
        self.synth = (i, speed, proc)

    def _synthesized(self, i, speed, out, proc):
        self.synth = None
        proc.deleteLater()
        if self.stopped:
            return
        if speed == self.speed and out.exists():
            self.wavs[i] = (speed, out)
        if self.player is None:
            self._play()
        self._synth(self.i + 1 if self.player is not None else self.i)

    def _play(self):
        if self.stopped or self.paused:
            return
        if self.i >= len(self.parts):
            self.finished.emit()
            return
        w = self.wavs.get(self.i)
        if not w or w[0] != self.speed:
            self._synth(self.i)              # not ready yet: plays when it is
            return
        self.progress.emit(self.i, len(self.parts))
        self.player = QProcess(self)
        self.player.finished.connect(self._played)
        self.player.start("pw-play", [str(w[1])])
        self._synth(self.i + 1)

    def _played(self, *_):
        if self.player:
            self.player.deleteLater()
        self.player = None
        if self.stopped:
            return
        self.i += 1
        self._play()

    def set_speed(self, speed):
        """New speed: the current sentence starts again at it."""
        self.speed = speed
        if self.paused and self.player and self.player.processId():
            os.kill(self.player.processId(), signal.SIGCONT)
        if self.player:
            p, self.player = self.player, None
            p.finished.disconnect()
            p.kill()
            p.waitForFinished(500)
            p.deleteLater()
        self._play()

    def again(self):
        self.stopped, self.paused, self.i = False, False, 0
        self._play()

    def pause(self):
        """Freeze the sound where it is (the player is suspended, so Resume carries on mid-word)."""
        self.paused = True
        if self.player and self.player.processId():
            os.kill(self.player.processId(), signal.SIGSTOP)

    def resume(self):
        self.paused = False
        if self.player and self.player.processId():
            os.kill(self.player.processId(), signal.SIGCONT)
        elif self.player is None:
            self._play()

    def stop(self):
        self.stopped = True
        if self.paused and self.player and self.player.processId():
            os.kill(self.player.processId(), signal.SIGCONT)      # a stopped process can't be killed cleanly
        self.paused = False
        for p in (self.player, self.synth[2] if self.synth else None):
            if p is not None:
                p.kill()
                p.waitForFinished(500)

    def cleanup(self):
        self.stop()
        shutil.rmtree(self.dir, ignore_errors=True)


class NarrationWindow(QWidget):
    """The snip, popped out, with the narration's controls; the rest of VR stays usable. As a VR
    panel it can collapse to just an Expand button, and take a new snip in place (load)."""
    STYLE = ("QWidget { background: #0b1016; color: #e8ecf0; font-size: 30px; }"
             "QPushButton { background: #232a32; font-weight: 600; padding: 16px 28px; border-radius: 12px;"
             " min-width: 70px; }"
             "QPushButton:hover { background: #355b7a; } QPushButton:disabled { color: #3a434d; }")
    PANEL_STYLE = ("QWidget { background: #0b1016; color: #e8ecf0; font-size: 22px; }"
                   "QPushButton { background: #232a32; font-weight: 600; padding: 12px 20px; border-radius: 10px;"
                   " min-width: 50px; }"
                   "QPushButton:disabled { color: #3a434d; }")
    MINI_MARGIN = 14                              # around Expand: something to grab it by

    def __init__(self, image, text, speed, panel=False):
        super().__init__()
        self.panel, self.speed, self.narrator, self.collapsed = panel, speed, None, False
        self.toggled = False                     # the last resize was Collapse/Expand (see pivot)
        self.setWindowTitle("Screen snip: narrating")
        self.setStyleSheet(self.PANEL_STYLE if panel else self.STYLE)
        outer = QVBoxLayout(self)
        outer.setContentsMargins(0, 0, 0, 0)
        self.full = QWidget()
        outer.addWidget(self.full)
        lay = QVBoxLayout(self.full)
        if panel:
            # Its own VR panel (NarrationOverlay): compact, with a bar to move it by.
            lay.setContentsMargins(18, 10, 18, 16)
            handle = QLabel("⠿  Screen snip  ·  drag here to move")
            handle.setAlignment(Qt.AlignmentFlag.AlignCenter)
            handle.setStyleSheet("color: #9aa6b2; font-size: 18px; padding: 6px;"
                                 " background: #161c23; border-radius: 8px;")
            lay.addWidget(handle)
        else:
            # The Steam session shows every window as a 1920x1080 panel, so fill it: the snip as
            # large as fits above the controls.
            lay.setContentsMargins(40, 30, 40, 30)
        self.pic = QLabel()                       # the snip (or, after Paste, the pasted text)
        self.pic.setAlignment(Qt.AlignmentFlag.AlignCenter)
        lay.addWidget(self.pic, 1)
        self.state = QLabel("Preparing…")
        self.state.setStyleSheet("color: #9aa6b2;")
        lay.addWidget(self.state)
        row = QHBoxLayout()
        self.toggle = QPushButton("■ Stop")
        self.toggle.clicked.connect(self.stop_or_again)
        row.addWidget(self.toggle)
        self.pause_button = QPushButton("⏸ Pause")
        self.pause_button.clicked.connect(self.pause_or_resume)
        row.addWidget(self.pause_button)
        self.view_button = QPushButton("Show text")
        self.view_button.setToolTip("Switch between the snip's image and the text read from it")
        self.view_button.clicked.connect(self.toggle_view)
        row.addWidget(self.view_button)
        row.addStretch(1)
        self.slower, self.faster = QPushButton("−"), QPushButton("+")
        self.speed_label = QLabel()
        self.speed_label.setMinimumWidth(110 if not panel else 70)
        self.speed_label.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self.slower.clicked.connect(lambda: self.step(-1))
        self.faster.clicked.connect(lambda: self.step(1))
        for w in (QLabel("Speed"), self.slower, self.speed_label, self.faster):
            row.addWidget(w)
        lay.addLayout(row)
        # Second row: the text itself, and the panel.
        row2 = QHBoxLayout()
        self.copy_image_button = QPushButton("Copy image")
        self.copy_image_button.setToolTip("Put the snip's image on the clipboard")
        self.copy_image_button.clicked.connect(self.copy_image)
        copy = QPushButton("Copy text")
        copy.setToolTip("Put the text being read on the clipboard")
        copy.clicked.connect(self.copy_text)
        paste = QPushButton("Paste")
        paste.setToolTip("Read the clipboard's text instead")
        paste.clicked.connect(self.paste_text)
        # Collapse at both ends (icon only on the left), so it can be collapsed toward either side;
        # the copy buttons centred between equal-width ends.
        left, right = QWidget(), QWidget()
        left_lay, right_lay = QHBoxLayout(left), QHBoxLayout(right)
        for l in (left_lay, right_lay):
            l.setContentsMargins(0, 0, 0, 0)
        close = QPushButton("Close")
        close.clicked.connect(self.close)
        right_lay.addWidget(close)
        self.collapse_buttons = []
        if panel:
            collapse_left = QPushButton()
            collapse_left.setIcon(breeze("expand"))      # (Breeze's "expand" is the down chevron)
