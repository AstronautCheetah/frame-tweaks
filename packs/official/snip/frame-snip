            collapse_left.setToolTip("Collapse")
            collapse_left.setStyleSheet("min-width: 0px; padding: 11px 12px;")
            collapse_left.clicked.connect(lambda: self.collapse(collapse_left))
            left_lay.addWidget(collapse_left)
            left_lay.addStretch(1)
            collapse = QPushButton("Collapse ")
            collapse.setIcon(breeze("expand"))
            collapse.setIconSize(QSize(30, 30))
            collapse.setLayoutDirection(Qt.LayoutDirection.RightToLeft)      # icon on the right
            collapse.clicked.connect(lambda: self.collapse(collapse))
            right_lay.addWidget(collapse)
            self.collapse_buttons = [collapse_left, collapse]
        self.collapse_button = self.collapse_buttons[-1] if panel else None    # the one last used
        row2.addWidget(left)
        row2.addStretch(1)
        for b in (self.copy_image_button, copy, paste):
            row2.addWidget(b)
        row2.addStretch(1)
        row2.addWidget(right)
        for b in (self.copy_image_button, copy, paste, close) + ((collapse,) if panel else ()):
            b.setStyleSheet("padding: 12px 14px; font-size: 20px;")        # (a narrower row)
        self.row2, self.left_end, self.right_end = row2, left, right
        self.ensurePolished()
        lay.addLayout(row2)
        # Collapsed: just Expand, with a margin to grab the panel by.
        self.mini = QWidget()
        mini = QHBoxLayout(self.mini)
        mini.setContentsMargins(*[self.MINI_MARGIN] * 4)
        expand = QPushButton()
        expand.setIcon(breeze("collapse"))                # (and its "collapse" the up chevron)
        expand.setIconSize(QSize(36, 36))
        expand.setToolTip("Expand")
        expand.setStyleSheet("min-width: 0px; padding: 10px;")
        expand.clicked.connect(self.expand)
        self.expand_button = expand
        mini.addWidget(expand)
        self.mini.hide()
        outer.addWidget(self.mini)
        self.show_speed()
        self.load(image, text)

    def load(self, image, text):
        """Read a (new) snip: stops what was being read, keeps the panel and its place. image None:
        pasted text (shown as text)."""
        if self.narrator is not None:
            self.narrator.cleanup()
        self.image, self.text = image, text
        self.view = "image" if image is not None else "text"
        self.view_button.setEnabled(image is not None)
        self.copy_image_button.setEnabled(image is not None)
        self.show_view()
        self.state.setText("Preparing…")
        self.toggle.setText("■ Stop")
        self.pause_button.setText("⏸ Pause")
        self.pause_button.setEnabled(True)
        self.narrator = Narrator(text, self.speed)
        self.narrator.progress.connect(lambda i, n: self.state.setText(f"Reading aloud: part {i + 1} of {n}"))
        self.narrator.finished.connect(self.done)
        self.narrator.start()
        self.expand() if self.collapsed else self.fit()

    def show_view(self):
        """The snip's image, or the text (OCR'd or pasted)."""
        if self.view == "text" or self.image is None:
            shown = self.text if len(self.text) <= 600 else self.text[:600].rstrip() + " …"
            self.pic.setPixmap(QPixmap())
            self.pic.setWordWrap(True)
            self.pic.setText(shown)
            self.pic.setStyleSheet("background: #161c23; border-radius: 8px; padding: 14px;"
                                   " font-size: 20px; color: #e8ecf0;")
            self.pic.setAlignment(Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignTop)
            self.pic_width = 820 if self.panel else 1800
            self.pic.setFixedWidth(self.pic_width)
        else:
            box = (860, 440) if self.panel else (1840, 800)
            pm = QPixmap.fromImage(self.image)
            if pm.width() > box[0] or pm.height() > box[1] or not self.panel:
                pm = pm.scaled(*box, Qt.AspectRatioMode.KeepAspectRatio, Qt.TransformationMode.SmoothTransformation)
            self.pic.setText("")
            # (a word-wrapping label measures its height from its text alone: 0 for an image)
            self.pic.setWordWrap(False)
            self.pic.setStyleSheet("")
            self.pic.setAlignment(Qt.AlignmentFlag.AlignCenter)
            self.pic.setMinimumWidth(0)
            self.pic.setMaximumWidth(16777215)
            self.pic.setPixmap(pm)
            self.pic_width = pm.width()
        self.view_button.setText("Show image" if self.view == "text" else "Show text")

    def toggle_view(self):
        self.view = "text" if self.view == "image" else "image"
        self.show_view()
        self.fit()

    def copy_image(self):
        if self.image is None:
            return
        ok = copy_image_everywhere(self.image)
        self.state.setText("Image copied to the clipboard." if ok else "Couldn't copy (is desktop mode running?)")

    def copy_text(self):
        ok = to_clipboard(self.text.encode(), "text/plain;charset=utf-8")
        self.state.setText("Text copied to the clipboard." if ok else "Couldn't copy (is desktop mode running?)")

    def paste_text(self):
        text = from_clipboard()
        if not text:
            self.state.setText("The clipboard has no text.")
            return
        self.load(None, text)

    def fit(self):
        if not self.panel:
            self.resize(1920, 1080)
            return
        self.setMinimumSize(0, 0)
        self.setMaximumSize(16777215, 16777215)
        if self.collapsed:
            self.setFixedSize(self.mini.sizeHint())
        else:
            # (styled sizes are known once shown: the left end as wide as the right centres the middle)
            self.left_end.setMinimumWidth(self.right_end.sizeHint().width())
            w = max(780, min(900, self.pic_width + 36), self.row2.sizeHint().width() + 36)
            self.full.setFixedWidth(w)
            self.setFixedSize(w, self.full.sizeHint().height())

    def pivot(self, b=None):
        """Where the Collapse / Expand icon is (widget pixels): the overlay keeps that point still
        when the panel collapses or expands, so the icon stays under the laser. b: that button
        (default: Expand when collapsed, else the Collapse last used)."""
        b = b or (self.expand_button if self.collapsed else self.collapse_button)
        if b is None:
            return None
        if b is self.collapse_buttons[-1]:              # its icon, at the right end
            p = b.mapTo(self, QPoint(b.width() - 14 - 15, b.height() // 2))       # (padding, half the icon)
        else:
            p = b.mapTo(self, QPoint(b.width() // 2, b.height() // 2))
        return p

    def pivots(self):
        """{button: its icon's point} for each Collapse / Expand button now showing: which one is
        pressed next is only known then, so the overlay remembers them all."""
        shown = [self.expand_button] if self.collapsed else self.collapse_buttons
        return {b: self.pivot(b) for b in shown if b is not None}

    def collapse(self, button=None):
        """button: the Collapse used (left or right); Expand comes back to it, its icon in place."""
        self.collapse_button = button or self.collapse_button
        self.toggled = True
        self.collapsed = True
        self.full.hide()
        self.mini.show()
        self.fit()

    def expand(self):
        self.toggled = True
        self.collapsed = False
        self.mini.hide()
        self.full.show()
        self.fit()

    def show_speed(self):
        self.speed_label.setText(f"{self.speed:g}×")
        self.slower.setEnabled(self.speed > SPEEDS[0])
        self.faster.setEnabled(self.speed < SPEEDS[-1])

    def step(self, d):
        i = min(max(0, SPEEDS.index(self.speed) + d), len(SPEEDS) - 1)
        self.speed = SPEEDS[i]
        self.show_speed()
        save_speed(self.speed)
        if not self.narrator.stopped:
            self.narrator.set_speed(self.speed)
            if self.narrator.paused:                     # a new speed carries on reading
                self.narrator.paused = False
                self.pause_button.setText("⏸ Pause")
                self.state.setText("Reading aloud…")

    def done(self):
        self.state.setText("Finished.")
        self.toggle.setText("▶ Again")
        self.pause_button.setEnabled(False)

    def pause_or_resume(self):
        if self.narrator.paused:
            self.narrator.resume()
            self.pause_button.setText("⏸ Pause")
            self.state.setText("Reading aloud…")
        else:
            self.narrator.pause()
            self.pause_button.setText("▶ Resume")
            self.state.setText("Paused.")

    def stop_or_again(self):
        if self.narrator.stopped or self.toggle.text().startswith("▶"):
            self.narrator.speed = self.speed
            self.toggle.setText("■ Stop")
            self.state.setText("Reading aloud…")
            self.pause_button.setText("⏸ Pause")
            self.pause_button.setEnabled(True)
            self.narrator.again()
        else:
            self.narrator.stop()
            self.state.setText("Stopped.")
            self.toggle.setText("▶ Again")
            self.pause_button.setText("⏸ Pause")
            self.pause_button.setEnabled(False)

    def closeEvent(self, ev):
        self.narrator.cleanup()
        super().closeEvent(ev)


class GripReader:
    """Grip squeezes, read as Arrow Pad and Full Keyboard read them (the Frame's dashboard hides
    grip actions from apps, but the controller model's "button_grip" part still moves): its
    rotation from the rest pose, held from 1.0°, released below 0.5°, armed after a release."""

    def __init__(self, openvr):
        self.vr = openvr
        self.sys, self.rm, self.inp = openvr.VRSystem(), openvr.VRRenderModels(), openvr.VRInput()
        self.hands = [{"role": role, "path": self.inp.getInputSourceHandle(f"/user/hand/{hand}"),
                       "armed": False, "held": False, "device": None}
                      for hand, role in (("left", openvr.TrackedControllerRole_LeftHand),
                                         ("right", openvr.TrackedControllerRole_RightHand))]

    @staticmethod
    def _angle(a, b):
        import math
        tr = sum(a.m[r][c] * b.m[r][c] for r in range(3) for c in range(3))
        return math.degrees(math.acos(max(-1.0, min(1.0, (tr - 1) / 2))))

    def poll(self):
        """[(device, held, just_pressed)] for each connected controller."""
        vr, out = self.vr, []
        for h in self.hands:
            try:
                d = self.sys.getTrackedDeviceIndexForControllerRole(h["role"])
                if d == vr.k_unTrackedDeviceIndexInvalid or not self.sys.isTrackedDeviceConnected(d):
                    h.update(armed=False, held=False, device=None)
                    continue
                if d != h["device"]:
                    h.update(armed=False, held=False, device=d)
                model = self.sys.getStringTrackedDeviceProperty(d, vr.Prop_RenderModelName_String)
                mode = vr.RenderModel_ControllerMode_State_t()
                ok1, cur = self.rm.getComponentStateForDevicePath(model, "button_grip", h["path"], mode)
                ok2, rest = self.rm.getComponentState(model, "button_grip", vr.VRControllerState_t(), mode)
                if not (ok1 and ok2):
                    h.update(armed=False, held=False)
                    continue
                a = self._angle(rest.mTrackingToComponentRenderModel, cur.mTrackingToComponentRenderModel)
            except Exception:
                h.update(armed=False, held=False)
                continue
            if not h["armed"]:
                h["armed"] = a < 0.5
                continue
            held = a >= (0.5 if h["held"] else 1.0)
            out.append((d, held, held and not h["held"]))
            h["held"] = held
        return out


class NarrationOverlay(QObject):
    """Shows a widget as its own SteamVR overlay, the way Arrow Pad does: laser clicks reach its
    buttons; a press elsewhere (its top bar, say) carries it with the controller until released.
    It redraws only when the widget changes, behind a cover overlay so a reload doesn't blink."""
    WIDTH_M = 0.6
    M_PER_PX = 0.6 / 880                         # constant scale: a collapsed panel is small too

    def __init__(self, widget):
        super().__init__()
        import openvr
        self.vr, self.w = openvr, widget
        openvr.init(openvr.VRApplication_Overlay)
        self.ov, self.system = openvr.VROverlay(), openvr.VRSystem()
        key = f"frame-tweaks.snip.narration.{os.getpid()}"
        self.h = self.ov.createOverlay(key, "Screen snip")
        self.cover = self.ov.createOverlay(key + ".cover", "Screen snip")
        self.ov.setOverlayInputMethod(self.h, openvr.VROverlayInputMethod_Mouse)
        self.ov.setOverlaySortOrder(self.h, 10)
        self.ov.setOverlaySortOrder(self.cover, 11)
        self.width_px = 0
        self.size_m()
        self.drag = None
        self.grip_drag = False                      # the current carry is a grip squeeze
        self.hovered = set()                        # controllers whose laser is on the panel
        try:
            self.grips = GripReader(openvr)
        except Exception:
            self.grips = None
        self.offset = self.load_offset()            # the panel relative to the dashboard bar
        if not (self.offset and self.follow()):
            self.place_default()
        QTimer(self, interval=100, timeout=self.follow).start()
        self.tex_dir = Path(tempfile.mkdtemp(prefix="snip-panel-"))
        self.n, self.last_digest, self.cover_path, self.pressed, self.drag = 0, None, None, None, None
        self.render()
        self.ov.showOverlay(self.h)
        QTimer(self, interval=22, timeout=self.poll).start()
        QTimer(self, interval=200, timeout=self.render).start()

    def size_m(self):
        """Overlay width from the widget's (constant metres per pixel); True if it changed."""
        if self.w.width() == self.width_px:
            return False
        self.width_px = self.w.width()
        # (the cover keeps the old size and place until the new picture is up: see render)
        self.ov.setOverlayWidthInMeters(self.h, self.width_px * self.M_PER_PX)
        return True

    def height_m(self):
        return self.w.height() * self.M_PER_PX

    # The panel is placed by its top edge (top centre), so it keeps its place when it changes
    # size (collapse / expand, a new snip); the overlay itself is positioned by its centre.
    def centre_from_top(self, top):
        h = self.height_m() / 2
        return [[top[i][0], top[i][1], top[i][2], top[i][3] - top[i][1] * h] for i in range(3)]

    def top_from_centre(self, c):
        h = self.height_m() / 2
        return [[c[i][0], c[i][1], c[i][2], c[i][3] + c[i][1] * h] for i in range(3)]

    def matrix(self, rows):
        m = self.vr.HmdMatrix34_t()
        for i in range(3):
            for j in range(4):
                m.m[i][j] = rows[i][j]
        return m

    def device_pose(self, index):
        poses = self.system.getDeviceToAbsoluteTrackingPose(self.vr.TrackingUniverseStanding, 0, index + 1)
        if index >= len(poses) or not poses[index].bPoseIsValid:
            return None
        m = poses[index].mDeviceToAbsoluteTracking.m
        return [[m[r][c] for c in range(4)] for r in range(3)]

    BAR = "valve.steam.gamepadui.bar"
    # Default spot: beside Arrow Pad's (which is centred under the dashboard bar), to its left,
    # at its height, 24 cm toward you, leaning back 30° for reading.
    LEFT, BELOW, TOWARD, PITCH = 0.62, 0.06, 0.24, 30

    def anchor(self):
        """The dashboard bar's bottom centre, scale removed (as Arrow Pad uses it), or None."""
        try:
            h = self.ov.findOverlay(self.BAR)
            scale = self.ov.getOverlayMouseScale(h)
            at = self.vr.HmdVector2_t()
            at.v[0], at.v[1] = scale.v[0] / 2, 0.0
            r = self.ov.getTransformForOverlayCoordinates(h, self.vr.TrackingUniverseStanding, at)
            m = r.m if hasattr(r, "m") else r[-1].m
            rows = [[m[i][j] for j in range(4)] for i in range(3)]
            for c in range(3):
                n = sum(rows[i][c] ** 2 for i in range(3)) ** 0.5 or 1.0
                for i in range(3):
                    rows[i][c] /= n
            return rows
        except Exception:
            return None

    def follow(self):
        """Pose = dashboard anchor x the remembered offset (follows the dashboard when it moves)."""
        if self.drag is not None or not getattr(self, "offset", None):
            return False
        if getattr(self, "height_px", 0) and (self.w.width(), self.w.height()) != (self.width_px, self.height_px):
            return True                       # a resize is pending: render() places it (pivot / top edge)
        a = self.anchor()
        if a is None:
            return False
        pose = self.centre_from_top(self.compose(a, self.offset))
        if not getattr(self, "pose", None) or max(abs(x - y) for r1, r2 in zip(pose, self.pose) for x, y in zip(r1, r2)) > 0.0015:
            self.pose = pose
            self.apply_pose()
        return True

    def load_offset(self):
        try:
            off = json.loads(SETTINGS.read_text()).get("panel_top")
            return off if isinstance(off, list) and len(off) == 3 else None
        except (OSError, ValueError, AttributeError):
            return None

    def save_offset(self):
        a = self.anchor()
        if a is None:
            return
        self.offset = self.relative(a, self.top_from_centre(self.pose))
        try:
            conf = json.loads(SETTINGS.read_text()) if SETTINGS.exists() else {}
        except (OSError, ValueError):
            conf = {}
        conf.pop("panel_offset", None)                # (older versions kept the centre)
        conf["panel_top"] = self.offset
        SETTINGS.parent.mkdir(parents=True, exist_ok=True)
        SETTINGS.write_text(json.dumps(conf) + "\n")

    def place_default(self):
        import math
        a = self.anchor()
        if a is None:
            return self.place_in_front()
        ax = [a[0][0], 0.0, a[2][0]]                        # the bar's left-right, made level
        n = math.hypot(ax[0], ax[2]) or 1.0
        ax = [ax[0] / n, 0.0, ax[2] / n]
        ay, az = [0.0, 1.0, 0.0], [-ax[2], 0.0, ax[0]]
        if az[0] * a[0][2] + az[2] * a[2][2] < 0:           # "toward you"
            az, ax = [-az[0], 0.0, -az[2]], [-ax[0], 0.0, -ax[2]]
        t = math.radians(self.PITCH)
        y = [ay[i] * math.cos(t) - az[i] * math.sin(t) for i in range(3)]
        z = [ay[i] * math.sin(t) + az[i] * math.cos(t) for i in range(3)]
        h_m = self.WIDTH_M * self.w.height() / max(1, self.w.width())
        org = [a[i][3] for i in range(3)]
        centre = [org[i] - ax[i] * self.LEFT - ay[i] * self.BELOW - y[i] * (h_m / 2) + az[i] * self.TOWARD
                  for i in range(3)]
        self.pose = [[ax[i], y[i], z[i], centre[i]] for i in range(3)]
        self.apply_pose()
        self.save_offset()

    def place_in_front(self):
        """Without a dashboard: 0.65 m ahead of the headset, a little below eye level, facing you."""
        head = self.device_pose(self.vr.k_unTrackedDeviceIndex_Hmd)
        if head is None:
            fx, fz, pos = 0.0, -1.0, [0.0, 1.4, 0.0]
        else:
            fx, fz = -head[0][2], -head[2][2]
            n = (fx * fx + fz * fz) ** 0.5 or 1.0
            fx, fz, pos = fx / n, fz / n, [head[r][3] for r in range(3)]
        x_axis, z_axis = [-fz, 0.0, fx], [-fx, 0.0, -fz]
        centre = [pos[0] + fx * 0.65, pos[1] - 0.15, pos[2] + fz * 0.65]
        self.pose = [[x_axis[i], (0.0, 1.0, 0.0)[i], z_axis[i], centre[i]] for i in range(3)]
        self.apply_pose()

    def apply_pose(self, cover=True):
        m = self.matrix(self.pose)
        for o in (self.h, self.cover) if cover else (self.h,):
            self.ov.setOverlayTransformAbsolute(o, self.vr.TrackingUniverseStanding, m)

    def render(self):
        resized = self.w.width() != self.width_px or self.w.height() != getattr(self, "height_px", 0)
        if resized and self.cover_path is not None:
            # A new size (Collapse / Expand, a new snip): the old picture stretched to the new size
            # flickered like static. Show the old one (cover: old size and place) and hide the
            # panel until its new picture has loaded.
            self.ov.showOverlay(self.cover)
            self.ov.hideOverlay(self.h)
        if resized:
            k = self.M_PER_PX
            old_w, old_h = self.width_px, getattr(self, "height_px", 0)
            new_w, new_h = self.w.width(), self.w.height()
            moved = False
            if getattr(self, "pose", None) and old_h:
                # The point of the button just pressed, before (remembered) and now.
                pressed = self.w.collapse_button if self.w.collapsed else self.w.expand_button
                pv, old_pv = self.w.pivot(), getattr(self, "last_pivots", {}).get(pressed)
                if getattr(self.w, "toggled", False) and pv is not None and old_pv is not None:
                    # Collapse / Expand: the icon's point stays where it was.
                    a = (old_pv.x() - old_w / 2 - (pv.x() - new_w / 2)) * k     # along the panel's x
                    b = (old_pv.y() - old_h / 2 - (pv.y() - new_h / 2)) * k     # pixels down = -y
                    self.pose = [[c[0], c[1], c[2], c[3] + c[0] * a - c[1] * b] for c in self.pose]
                else:                                       # otherwise the top edge stays
                    self.pose = [[c[0], c[1], c[2], c[3] + c[1] * (old_h - new_h) * k / 2] for c in self.pose]
                moved = True
            self.w.toggled = False
            self.size_m()
            self.height_px = new_h
            if moved:
                self.apply_pose(cover=False)
                if self.offset:                             # (follow() works from the offset)
                    self.save_offset()
        self.last_pivots = self.w.pivots() if hasattr(self.w, "pivots") else {}
        img = self.w.grab().toImage()
        digest = hash(bytes(img.constBits().asstring(img.sizeInBytes())))
        if digest == self.last_digest and not resized:
            return
        self.last_digest = digest
        self.n += 1
        path = str(self.tex_dir / f"panel-{self.n}.png")      # new name each time (SteamVR caches by name)
        img.save(path, "PNG")
        covered = self.cover_path is not None
        if covered:
            self.ov.showOverlay(self.cover)                   # the old picture on top while it reloads
        self.ov.setOverlayFromFile(self.h, path)
        scale = self.vr.HmdVector2_t()
        scale.v[0], scale.v[1] = img.width(), img.height()
        self.ov.setOverlayMouseScale(self.h, scale)
        QTimer.singleShot(120 if covered else 0, lambda: self.uncover(path))

    def uncover(self, path):
        self.ov.showOverlay(self.h)
        self.ov.hideOverlay(self.cover)
        self.ov.setOverlayFromFile(self.cover, path)
        self.ov.setOverlayWidthInMeters(self.cover, self.width_px * self.M_PER_PX)
        self.apply_pose()
        old, self.cover_path = self.cover_path, path
        if old and old != path:
            Path(old).unlink(missing_ok=True)

    def to_widget(self, mouse):
        return QPoint(int(mouse.x), int(self.w.height() - mouse.y))

    def send(self, target, etype, pos, buttons):
        local = target.mapFrom(self.w, pos) if target is not self.w else pos
        QApplication.sendEvent(target, QMouseEvent(etype, QPointF(local), QPointF(pos), Qt.MouseButton.LeftButton,
                                                   buttons, Qt.KeyboardModifier.NoModifier))

    def button_at(self, pos):
        t = self.w.childAt(pos)
        while t is not None and not isinstance(t, QPushButton):
            t = t.parentWidget()
        return t

    def poll(self):
        vr, ev = self.vr, self.vr.VREvent_t()
        while self.ov.pollNextOverlayEvent(self.h, ev)[0]:
            t, dev = ev.eventType, ev.trackedDeviceIndex
            if t == vr.VREvent_FocusLeave:
                if dev == vr.k_unTrackedDeviceIndexInvalid:
                    self.hovered.clear()
                else:
                    self.hovered.discard(dev)
                continue
            if t == vr.VREvent_MouseMove:
                self.hovered.add(dev)
            if t == vr.VREvent_MouseButtonDown and self.drag is not None:
                continue                                       # carrying it by the grip: no clicks
            if t == vr.VREvent_MouseButtonDown:
                pos = self.to_widget(ev.data.mouse)
                b = self.button_at(pos)
                if b is not None:
                    self.pressed = b
                    self.send(b, QEvent.Type.MouseButtonPress, pos, Qt.MouseButton.LeftButton)
                else:                                          # elsewhere: carry the panel
                    ctrl = self.device_pose(dev)
                    if ctrl is not None:
                        self.drag = (dev, self.relative(ctrl, self.pose))
            elif t == vr.VREvent_MouseButtonUp:
                pos = self.to_widget(ev.data.mouse)
                if self.pressed is not None:
                    self.send(self.pressed, QEvent.Type.MouseButtonRelease, pos, Qt.MouseButton.NoButton)
                    self.pressed = None
                if self.drag is not None and not self.grip_drag:
                    self.drag = None
                    self.save_offset()                     # remembered relative to the dashboard
        # Grip to carry it, as on Arrow Pad and Full Keyboard: squeeze while that controller's
        # laser is on the panel (buttons included), let go to put it down.
        grips = self.grips.poll() if self.grips else []
        held = {d for d, h, _ in grips if h}
        for d, _, pressed in grips:
            if pressed and d in self.hovered and self.drag is None:
                ctrl = self.device_pose(d)
                if ctrl is not None:
                    if self.pressed is not None:           # a squeeze cancels a press in progress
                        self.send(self.pressed, QEvent.Type.MouseButtonRelease, QPoint(-1, -1), Qt.MouseButton.NoButton)
                        self.pressed = None
                    self.drag, self.grip_drag = (d, self.relative(ctrl, self.pose)), True
        if self.drag is not None and self.grip_drag and self.drag[0] not in held:
            self.drag, self.grip_drag = None, False
            self.save_offset()
        if self.drag is not None:
            ctrl = self.device_pose(self.drag[0])
            if ctrl is not None:
                self.pose = self.compose(ctrl, self.drag[1])
                self.apply_pose()

    @staticmethod
    def compose(a, b):
        return [[sum(a[i][k] * b[k][j] for k in range(3)) + (a[i][3] if j == 3 else 0) for j in range(4)] for i in range(3)]

    @staticmethod
    def relative(a, b):
        """a^-1 * b for rigid 3x4 transforms."""
        rt = [[a[k][i] for k in range(3)] for i in range(3)]
        t = [-sum(rt[i][k] * a[k][3] for k in range(3)) for i in range(3)]
        inv = [rt[i] + [t[i]] for i in range(3)]
        return NarrationOverlay.compose(inv, b)

    def close(self):
        try:
            for o in (self.h, self.cover):
                self.ov.destroyOverlay(o)
            self.vr.shutdown()
        except Exception:
            pass
        shutil.rmtree(self.tex_dir, ignore_errors=True)


def vr_panel_available():
    try:
        import openvr  # noqa: F401
        return True
    except Exception:
        return False


# ---- selection window -----------------------------------------------------------------------
class Snip(QWidget):
    def __init__(self, image):
        super().__init__()
        self.setWindowTitle("Screen snip")
        self.image, self.pix = image, QPixmap.fromImage(image)
        self.start = self.end = None              # a new rectangle being drawn
        self.sel = None                           # the selection, once drawn (adjustable)
        self.drag = None
        self.setCursor(Qt.CursorShape.CrossCursor)
        self.hint = QLabel("Drag a rectangle to snip, then adjust it with its handles  ·  Esc or right-click cancels", self)
        self.hint.setStyleSheet("background: rgba(11,16,22,220); color: #e8ecf0; font-size: 22px;"
                                "padding: 10px 18px; border-radius: 10px;")
        self.hint.adjustSize()
        self.bar = QWidget(self)
        self.bar.setStyleSheet(
            "QWidget { background: rgba(11,16,22,235); border-radius: 12px; }"
            "QPushButton { background: #232a32; color: #e8ecf0; font-size: 22px; font-weight: 600;"
            " padding: 14px 22px; border-radius: 10px; min-width: 120px; }"
            "QPushButton:hover { background: #355b7a; }")
        lay = QHBoxLayout(self.bar)
        lay.setContentsMargins(10, 10, 10, 10)
        self.speed = load_speed()
        for label, fn in (("Copy", self.copy_image), ("Save", self.save), ("Copy text", self.copy_text),
                          ("Narrate", self.narrate), ("Cancel", self.close)):
            b = QPushButton(label)
            b.clicked.connect(fn)
            if label != "Narrate":
                lay.addWidget(b, 0, Qt.AlignmentFlag.AlignTop)
                continue
            # Narrate, with its reading speed underneath
            cell = QVBoxLayout()
            cell.setSpacing(6)
            cell.addWidget(b)
            speeds = QHBoxLayout()
            self.speed_down, self.speed_up = QPushButton("−"), QPushButton("+")
            self.speed_text = QLabel()
            self.speed_text.setAlignment(Qt.AlignmentFlag.AlignCenter)
            self.speed_text.setStyleSheet("background: transparent; color: #e8ecf0; font-size: 20px;")
            self.speed_text.setMinimumWidth(70)
            for w, step in ((self.speed_down, -1), (self.speed_up, 1)):
                w.setStyleSheet("min-width: 44px; max-width: 44px; padding: 6px 0px; font-size: 22px;")
                w.clicked.connect(lambda _=False, st=step: self.step_speed(st))
            speeds.addWidget(self.speed_down)
            speeds.addWidget(self.speed_text, 1)
            speeds.addWidget(self.speed_up)
            cell.addLayout(speeds)
            lay.addLayout(cell)
            self.narrate_button = b
        self.show_speed()
        self.bar.adjustSize()
        self.bar.hide()
        self.resize(self.pix.size())
        self.hint.move((self.width() - self.hint.width()) // 2, 24)

    # selection: draw a rectangle, then adjust it with the handles (or drag it from inside)
    HANDLE = 30                                   # px: handle size, big enough for the laser

    def selection(self):
        if self.sel is not None:
            return self.sel
        if not self.start or not self.end:
            return QRect()
        r = QRect(self.start, self.end).normalized()
        return r if r.width() >= MIN_SIZE and r.height() >= MIN_SIZE else QRect()

    def handles(self):
        """name -> square: corners and edge midpoints of the selection ("tl", "tc", ... "br")."""
        r = self.sel
        if r is None:
            return {}
        xs = {"l": r.left(), "c": r.center().x(), "r": r.right()}
        ys = {"t": r.top(), "m": r.center().y(), "b": r.bottom()}
        h = self.HANDLE
        return {v + u: QRect(xs[u] - h // 2, ys[v] - h // 2, h, h)
                for v in "tmb" for u in "lcr" if v + u != "mc"}

    def scale_to_image(self):
        return self.image.width() / max(1, self.width()), self.image.height() / max(1, self.height())

    def snipped(self):
        r = self.selection()
        sx, sy = self.scale_to_image()
        return self.image.copy(round(r.x() * sx), round(r.y() * sy), round(r.width() * sx), round(r.height() * sy))

    def place_bar(self):
        r = self.sel
        x = min(max(0, r.center().x() - self.bar.width() // 2), self.width() - self.bar.width())
        below = r.bottom() + self.HANDLE
        y = below if below + self.bar.height() <= self.height() else max(0, r.top() - self.HANDLE - self.bar.height())
        self.bar.move(x, y)
        self.bar.show()
        self.bar.raise_()

    def mousePressEvent(self, ev):
        if ev.button() == Qt.MouseButton.RightButton:
            return self.close()
        p = ev.position().toPoint()
        self.drag = None
        if self.sel is not None:
            for name, sq in self.handles().items():
                if sq.adjusted(-6, -6, 6, 6).contains(p):
                    self.drag = ("resize", name, QRect(self.sel))
                    break
            else:
                if self.sel.contains(p):
                    self.drag = ("move", p, QRect(self.sel))
        if self.drag is None:                     # outside: start a new selection
            self.sel = None
            self.start = self.end = p
            self.drag = ("new",)
        self.bar.hide()
        self.update()

    def mouseMoveEvent(self, ev):
        if not self.drag:
            return
        p = ev.position().toPoint()
        bounds = self.rect()
        if self.drag[0] == "new":
            self.end = p
        elif self.drag[0] == "move":
            r = QRect(self.drag[2])
            r.translate(p - self.drag[1])
            r.moveLeft(min(max(0, r.left()), bounds.width() - r.width()))
            r.moveTop(min(max(0, r.top()), bounds.height() - r.height()))
            self.sel = r
        else:
            name, r = self.drag[1], QRect(self.drag[2])
            x, y = min(max(0, p.x()), bounds.width() - 1), min(max(0, p.y()), bounds.height() - 1)
            if name[1] == "l":
                r.setLeft(min(x, r.right() - MIN_SIZE))
            if name[1] == "r":
                r.setRight(max(x, r.left() + MIN_SIZE))
            if name[0] == "t":
                r.setTop(min(y, r.bottom() - MIN_SIZE))
            if name[0] == "b":
                r.setBottom(max(y, r.top() + MIN_SIZE))
            self.sel = r
        self.update()

    def mouseReleaseEvent(self, ev):
        if not self.drag:
            return
        if self.drag[0] == "new":
            self.end = ev.position().toPoint()
            r = self.selection()
            self.sel = None if r.isNull() else r
            self.start = self.end = None
        self.drag = None
        if self.sel is not None:
            self.place_bar()
        self.update()

    def keyPressEvent(self, ev):
        if ev.key() == Qt.Key.Key_Escape:
            self.close()

    def paintEvent(self, ev):
        p = QPainter(self)
        p.drawPixmap(self.rect(), self.pix)
        p.fillRect(self.rect(), QColor(0, 0, 0, 110))            # dim everything...
        r = self.selection()
        if not r.isNull():
            sx, sy = self.scale_to_image()
            p.drawPixmap(r, self.pix, QRect(round(r.x() * sx), round(r.y() * sy),
                                            round(r.width() * sx), round(r.height() * sy)))   # ...but the snip
            p.setPen(QPen(QColor("#7fb2e5"), 3))
            p.drawRect(r)
            p.setPen(QPen(QColor("#0b1016"), 2))
            p.setBrush(QColor("#7fb2e5"))
            for sq in self.handles().values():
                p.drawRoundedRect(sq, 6, 6)
        self.hint.setVisible(r.isNull())

    # actions
    def copy_image(self):
        ok = copy_image_everywhere(self.snipped())
        notify("Snip copied" if ok else "Couldn't copy the snip", "" if ok else "the desktop isn't available")
        self.close()

    def save(self):
        SAVE_DIR.mkdir(parents=True, exist_ok=True)
        path = SAVE_DIR / time.strftime("Snip_%Y-%m-%d_%H-%M-%S.png")
        ok = self.snipped().save(str(path))
        notify("Snip saved" if ok else "Couldn't save the snip", str(path))
        self.close()

    def copy_text(self):
        text = ocr(self.snipped())
        if text is None:
            notify("Copy text needs Tesseract", "Reinstall Screen snip in Frame Tweaks")
        elif not text:
            notify("No text found in the snip")
        else:
            ok = to_clipboard(text.encode(), "text/plain;charset=utf-8")
            notify("Text copied" if ok else "Couldn't copy the text", text)
        self.close()

    def show_speed(self):
        self.speed_text.setText(f"{self.speed:g}×")
        self.speed_down.setEnabled(self.speed > SPEEDS[0])
        self.speed_up.setEnabled(self.speed < SPEEDS[-1])

    def step_speed(self, d):
        self.speed = SPEEDS[min(max(0, SPEEDS.index(self.speed) + d), len(SPEEDS) - 1)]
        save_speed(self.speed)
        self.show_speed()

    def narrate(self):
        snip = self.snipped()
        text = ocr(snip)
        if not text:
            notify("No text found in the snip" if text == "" else "Narrate needs Tesseract",
                   "" if text == "" else "Reinstall Screen snip in Frame Tweaks")
            return self.close()
        if not PIPER.exists() or not VOICE.exists():
            notify("Narrate needs Piper", "Reinstall 'Speech engine' in Frame Tweaks")
            return self.close()
        # Pop the snip out and give the rest of VR back: the full-screen selection window closes.
        # In VR it's a panel of its own (a separate process, drawn like Arrow Pad); else a window.
        if vr_panel_available():
            d = Path(tempfile.mkdtemp(prefix="snip-narrate-in-"))
            snip.save(str(d / "snip.png"))
            (d / "text.txt").write_text(text)
            # A panel already open reads this one instead, where it is; otherwise start one.
            sock = QLocalSocket()
            sock.connectToServer(PANEL_SOCKET)
            if sock.waitForConnected(500):
                sock.write(json.dumps({"image": str(d / "snip.png"), "text": str(d / "text.txt")}).encode())
                sock.flush()
                sock.waitForBytesWritten(1000)
                sock.disconnectFromServer()
            else:
                subprocess.Popen([sys.executable, os.path.abspath(sys.argv[0]), "--narrate",
                                  str(d / "snip.png"), str(d / "text.txt")], start_new_session=True)
        else:
            self.popout = NarrationWindow(snip, text, self.speed)
            self.popout.show()
        self.close()


def narrate_panel(image_path, text_path):
    """The narration panel process (frame-snip --narrate): its own SteamVR overlay."""
    app = QApplication(sys.argv[:1])
    image, text = QImage(image_path), Path(text_path).read_text()
    shutil.rmtree(Path(image_path).parent, ignore_errors=True)
    w = NarrationWindow(image, text, load_speed(), panel=True)
    w.show()
    overlay = NarrationOverlay(w)
    # Later snips come here (one panel, in its place) instead of opening another.
    QLocalServer.removeServer(PANEL_SOCKET)
    server = QLocalServer()
    server.listen(PANEL_SOCKET)

    def take_snip():
        conn = server.nextPendingConnection()
        if conn is None:
            return
        def read():
            if not conn.waitForReadyRead(1000) and not conn.bytesAvailable():
                return
            try:
                req = json.loads(bytes(conn.readAll()).decode())
                img, txt = QImage(req["image"]), Path(req["text"]).read_text()
                shutil.rmtree(Path(req["image"]).parent, ignore_errors=True)
                w.load(img, txt)
            except (OSError, ValueError, KeyError):
                pass
            conn.disconnectFromServer()
        QTimer.singleShot(0, read)
    server.newConnection.connect(take_snip)
    w.destroyed.connect(app.quit)
    w.setAttribute(Qt.WidgetAttribute.WA_DeleteOnClose)
    code = app.exec()
    server.close()
    overlay.close()
    return code


def started_by_steam():
    """Started from Steam's "+" menu: Steam runs it as a game, with its overlay hooked in, and in
    VR the selection window then took no laser input. True if so (and it started itself again
    as a plain program, as Arrow Pad's Snip key does)."""
    if not (os.environ.get("SteamGameId") or os.environ.get("SteamAppId")) or os.environ.get("SFT_SNIP_PLAIN"):
        return False
    env = {k: v for k, v in os.environ.items()
           if not k.startswith(("Steam", "STEAM_", "SteamOverlay", "ENABLE_VK_LAYER"))}
    pre = [p for p in os.environ.get("LD_PRELOAD", "").replace(":", " ").split() if "gameoverlay" not in p]
    env.pop("LD_PRELOAD", None)
    if pre:
        env["LD_PRELOAD"] = ":".join(pre)
    env["SFT_SNIP_PLAIN"] = "1"
    subprocess.Popen([sys.executable, os.path.abspath(sys.argv[0]), *sys.argv[1:]], env=env,
                     start_new_session=True, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL)
    return True


def main():
    if started_by_steam():
        return 0
    if XCLIP:
        return x_clipboard_owner(sys.argv[2])
    if NARRATE:
        return narrate_panel(sys.argv[2], sys.argv[3])
    app = QApplication(sys.argv[:1])
    try:
        image = QImage(sys.argv[1]) if len(sys.argv) > 1 else capture_focused()
    except RuntimeError as e:
        notify("Couldn't take a snip", str(e))
        return 1
    if image.isNull():
        notify("Couldn't take a snip", "empty picture")
        return 1
    w = Snip(image)
    w.showFullScreen()
    w.activateWindow()
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
