class XImage(ctypes.Structure):
    _fields_ = [("width", ctypes.c_int), ("height", ctypes.c_int), ("xoffset", ctypes.c_int),
                ("format", ctypes.c_int), ("data", ctypes.c_void_p), ("byte_order", ctypes.c_int),
                ("bitmap_unit", ctypes.c_int), ("bitmap_bit_order", ctypes.c_int), ("bitmap_pad", ctypes.c_int),
                ("depth", ctypes.c_int), ("bytes_per_line", ctypes.c_int), ("bits_per_pixel", ctypes.c_int)]


class Attrs(ctypes.Structure):
    _fields_ = [("x", ctypes.c_int), ("y", ctypes.c_int), ("width", ctypes.c_int), ("height", ctypes.c_int),
                ("rest", ctypes.c_char * 256)]


def capture_focused():
    """The focused window of the Steam session (gamescope's GAMESCOPE_FOCUSED_WINDOW) as a QImage."""
    x = ctypes.cdll.LoadLibrary(ctypes.util.find_library("X11") or "libX11.so.6")
    x.XOpenDisplay.restype = ctypes.c_void_p
    x.XGetImage.restype = ctypes.c_void_p
    x.XInternAtom.restype = ctypes.c_ulong
    x.XDefaultRootWindow.restype = ctypes.c_ulong
    d = ctypes.c_void_p(x.XOpenDisplay(b":0"))
    if not d.value:
        raise RuntimeError(_("can't open the Steam session's display"))
    root = ctypes.c_ulong(x.XDefaultRootWindow(d))
    atom = x.XInternAtom(d, b"GAMESCOPE_FOCUSED_WINDOW", 1)
    rtype, fmt, n, after = ctypes.c_ulong(), ctypes.c_int(), ctypes.c_ulong(), ctypes.c_ulong()
    prop = ctypes.c_void_p()
    if not atom or x.XGetWindowProperty(d, root, ctypes.c_ulong(atom), 0, 1, 0, ctypes.c_ulong(6),   # XA_CARDINAL
                                        ctypes.byref(rtype), ctypes.byref(fmt), ctypes.byref(n),
                                        ctypes.byref(after), ctypes.byref(prop)) != 0 or not n.value:
        raise RuntimeError(_("no focused window"))
    win = ctypes.c_ulong(ctypes.cast(prop, ctypes.POINTER(ctypes.c_ulong))[0])
    x.XFree(prop)
    a = Attrs()
    x.XGetWindowAttributes(d, win, ctypes.byref(a))
    img = x.XGetImage(d, win, 0, 0, a.width, a.height, ctypes.c_ulong(0xFFFFFFFF), 2)        # ZPixmap
    if not img:
        raise RuntimeError(_("couldn't read the window's picture"))
    xi = XImage.from_address(img)
    data = ctypes.string_at(xi.data, xi.bytes_per_line * xi.height)
    q = QImage(data, xi.width, xi.height, xi.bytes_per_line, QImage.Format.Format_RGB32).copy()
    return q                                   # (the X image is freed when this short-lived tool exits)


def blank(img):
    """True if a picture is (nearly) all black: what X gives for a window that draws straight to
    gamescope (Proton and Vulkan games), which X never sees."""
    small = img.scaled(32, 32).convertToFormat(QImage.Format.Format_RGB32)
    return all(max(QColor(small.pixel(x, y)).getRgb()[:3]) < 12 for x in range(32) for y in range(32))


def capture_gamescope():
    """What gamescope shows, the focused app, games included, through its own screenshot
    (gamescopectl screenshot: a PNG, written a moment later)."""
    out = RUN / f"frame-snip-{os.getpid()}.png"
    env = dict(os.environ, XDG_RUNTIME_DIR=str(RUN),
               GAMESCOPE_WAYLAND_DISPLAY=os.environ.get("GAMESCOPE_WAYLAND_DISPLAY") or "gamescope-0")
    try:
        subprocess.run(["gamescopectl", "screenshot", str(out)], env=env, capture_output=True, timeout=5)
        size, end = -1, time.monotonic() + 3
        while time.monotonic() < end:              # (until it's there and stopped growing)
            now = out.stat().st_size if out.exists() else -1
            if now > 0 and now == size:
                break
            size = now
            time.sleep(0.15)
        img = QImage(str(out))
    except (OSError, subprocess.SubprocessError):
        img = QImage()
    finally:
        out.unlink(missing_ok=True)
    if img.isNull():
        raise RuntimeError(_("couldn't read the window's picture"))
    return img.convertToFormat(QImage.Format.Format_RGB32)


def capture():
    """The focused window: from X, as it is (full size); a game, which X has no picture of (it
    fails, or comes back black), from gamescope's own screenshot."""
    try:
        img = capture_focused()
        if not blank(img):
            return img
    except RuntimeError:
        pass
    return capture_gamescope()


