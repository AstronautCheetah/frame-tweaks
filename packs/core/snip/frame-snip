def tr_tip(w, tip):
    """A tooltip (and accessible name) in the user's language, kept in English too so it can
    follow a change of language (retranslate)."""
    w.setProperty("tr_tip", tip)
    w.setToolTip(_(tip))
    w.setAccessibleName(_(tip))


def tr_text(w, text, suffix="", **values):
    """A label's or button's text in the user's language, kept in English too (with its values)
    so it can follow a change of language (retranslate). Returns w."""
    w.setProperty("tr_text", text)
    w.setProperty("tr_values", json.dumps(values))
    w.setProperty("tr_suffix", suffix)
    w.setText(_(text).format(**values) + suffix if values else _(text) + suffix)
    return w


def retranslate_tips(root):
    """Every tr_tip / tr_text under root, again in the current language."""
    from PyQt6.QtWidgets import QWidget
    for w in [root, *root.findChildren(QWidget)]:
        tip = w.property("tr_tip")
        if tip:
            w.setToolTip(_(tip))
            w.setAccessibleName(_(tip))
        text = w.property("tr_text")
        if text:
            values = json.loads(w.property("tr_values") or "{}")
            w.setText((_(text).format(**values) if values else _(text)) + (w.property("tr_suffix") or ""))


