def made_here(folder, prefix):
    """folder, resolved, if it's one this program made to hand a snip to another of its processes
    (tempfile.mkdtemp(prefix=prefix) in the temporary folder: snip-narrate-in-, snip-clip-) and is
    yours; ValueError for any other folder. Only such a folder is read and then removed: the
    narration panel takes snips over a socket any program of yours can write to, and a path from
    it (or a command line) once had it read any file aloud and delete the folder it was in."""
    f = Path(folder).resolve()
    if (f.parent != Path(tempfile.gettempdir()).resolve() or not f.name.startswith(prefix) or not f.is_dir()
            or f.stat().st_uid != os.getuid()):
        raise ValueError(f"not a folder frame-snip made: {folder}")
    return f


def read_handed(folder, files):
    """{name: its contents} for files ({name: "rb" or "r", as for open()}), each a plain file in
    folder (from made_here), then the folder goes; ValueError for anything else, which is left
    alone. The folder and its files are opened without following a link, and checked once open:
    switched for a link after made_here looked, they'd have been read through (a file of yours
    read aloud, or put on the clipboard), and a FIFO would have kept this waiting."""
    def refuse():
        return ValueError(f"not a folder frame-snip made: {folder}")
    top = os.open(folder.parent, os.O_RDONLY | os.O_DIRECTORY)
    try:
        d = os.open(folder.name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=top)
    except OSError:
        raise refuse() from None
    finally:
        os.close(top)
    out = {}
    try:
        if os.fstat(d).st_uid != os.getuid():
            raise refuse()
        for name, mode in files.items():
            try:
                fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=d)
            except OSError:
                raise refuse() from None
            with open(fd, mode) as f:
                if not stat.S_ISREG(os.fstat(fd).st_mode):
                    raise refuse()
                out[name] = f.read()
    finally:
        os.close(d)
    shutil.rmtree(folder, ignore_errors=True)
    return out


def x_clipboard_owner(folder):
    """frame-snip --x-clipboard DIR: own the desktop's X clipboard (:2) and offer the files in DIR
    (clip.png, clip.bmp, clip.html) as image/png, image/bmp and text/html, until something else is
    copied. Some apps (OnlyOffice) don't take an image offered as PNG alone, which is all wl-copy
    can do; KWin passes the X clipboard on to Wayland apps too. No focus needed, unlike Wayland."""
    try:
        folder = made_here(folder, "snip-clip-")
    except ValueError as e:
        print(f"frame-snip: {e}", file=sys.stderr)
        return 1
    files = {"image/png": "clip.png", "image/bmp": "clip.bmp", "text/html": "clip.html"}
    try:
        found = read_handed(folder, {v: "rb" for v in files.values() if (folder / v).exists()})
    except (OSError, ValueError) as e:
        print(f"frame-snip: {e}", file=sys.stderr)
        return 1
    data = {k: found[v] for k, v in files.items() if v in found}
    auth = next(iter(sorted(RUN.glob("nested_plasma/xauth_*"))), None)
    if auth:
        os.environ["XAUTHORITY"] = str(auth)
    x = ctypes.cdll.LoadLibrary(ctypes.util.find_library("X11") or "libX11.so.6")
    x.XOpenDisplay.restype = ctypes.c_void_p
    x.XInternAtom.restype = ctypes.c_ulong
    x.XCreateSimpleWindow.restype = ctypes.c_ulong
    x.XDefaultRootWindow.restype = ctypes.c_ulong
    x.XGetSelectionOwner.restype = ctypes.c_ulong
    d = ctypes.c_void_p(x.XOpenDisplay(b":2"))
    if not d.value:
        return 1
    atom = lambda n: x.XInternAtom(d, n.encode(), 0)
    win = x.XCreateSimpleWindow(d, ctypes.c_ulong(x.XDefaultRootWindow(d)), 0, 0, 1, 1, 0, 0, 0)
    CLIP, TARGETS, TIMESTAMP, XA_ATOM, XA_INTEGER = atom("CLIPBOARD"), atom("TARGETS"), atom("TIMESTAMP"), 4, 19
    offers = {atom(k): v for k, v in data.items()}
    x.XSetSelectionOwner(d, ctypes.c_ulong(CLIP), ctypes.c_ulong(win), ctypes.c_ulong(0))
    if x.XGetSelectionOwner(d, ctypes.c_ulong(CLIP)) != win:
        return 1

    class Req(ctypes.Structure):                      # XSelectionRequestEvent
        _fields_ = [("type", ctypes.c_int), ("serial", ctypes.c_ulong), ("send_event", ctypes.c_int),
                    ("display", ctypes.c_void_p), ("owner", ctypes.c_ulong), ("requestor", ctypes.c_ulong),
                    ("selection", ctypes.c_ulong), ("target", ctypes.c_ulong), ("property", ctypes.c_ulong),
                    ("time", ctypes.c_ulong)]

    class Note(ctypes.Structure):                     # XSelectionEvent
        _fields_ = [("type", ctypes.c_int), ("serial", ctypes.c_ulong), ("send_event", ctypes.c_int),
                    ("display", ctypes.c_void_p), ("requestor", ctypes.c_ulong), ("selection", ctypes.c_ulong),
                    ("target", ctypes.c_ulong), ("property", ctypes.c_ulong), ("time", ctypes.c_ulong),
                    ("pad", ctypes.c_char * 64)]

    ev = (ctypes.c_char * 256)()
    while True:
        x.XNextEvent(d, ev)
        etype = ctypes.c_int.from_buffer(ev).value
        if etype == 29:                               # SelectionClear: something else was copied
            return 0
        if etype != 30:                               # SelectionRequest
            continue
        r = Req.from_buffer(ev)
        prop = r.property or r.target
        if r.target == TARGETS:
            atoms = (ctypes.c_ulong * (len(offers) + 2))(TARGETS, TIMESTAMP, *offers)
            x.XChangeProperty(d, ctypes.c_ulong(r.requestor), ctypes.c_ulong(prop), ctypes.c_ulong(XA_ATOM),
                              32, 0, atoms, len(atoms))
        elif r.target == TIMESTAMP:
            t = (ctypes.c_ulong * 1)(0)
            x.XChangeProperty(d, ctypes.c_ulong(r.requestor), ctypes.c_ulong(prop), ctypes.c_ulong(XA_INTEGER), 32, 0, t, 1)
        elif r.target in offers:
            blob = offers[r.target]
            x.XChangeProperty(d, ctypes.c_ulong(r.requestor), ctypes.c_ulong(prop), ctypes.c_ulong(r.target),
                              8, 0, ctypes.c_char_p(blob), len(blob))
        else:
            prop = 0                                  # can't give that
        note = Note(type=31, send_event=1, display=d, requestor=r.requestor, selection=r.selection,
                    target=r.target, property=prop, time=r.time)
        x.XSendEvent(d, ctypes.c_ulong(r.requestor), 0, 0, ctypes.byref(note))
        x.XFlush(d)


def copy_image_everywhere(image):
    """Put an image on the clipboard in the formats apps look for (PNG, BMP, an HTML <img>), via an
    X clipboard owner on the desktop; plain wl-copy (PNG only) if that can't start."""
    from PyQt6.QtCore import QBuffer, QByteArray, QIODevice
    import base64
    def encoded(fmt):
        buf = QByteArray()
        b = QBuffer(buf)
        b.open(QIODevice.OpenModeFlag.WriteOnly)
        image.save(b, fmt)
        return bytes(buf)
    png = encoded("PNG")
    if not list(RUN.glob("nested_plasma/xauth_*")):
        return to_clipboard(png, "image/png")
    d = Path(tempfile.mkdtemp(prefix="snip-clip-"))
    (d / "clip.png").write_bytes(png)
    (d / "clip.bmp").write_bytes(encoded("BMP"))
    (d / "clip.html").write_bytes(f'<img src="data:image/png;base64,{base64.b64encode(png).decode()}">'.encode())
    subprocess.Popen([sys.executable, os.path.abspath(sys.argv[0]), "--x-clipboard", str(d)], start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return True


def from_clipboard():
    """The desktop clipboard's text (wl-paste), or None."""
    sock = nested_wayland()
    if not sock or not wl_tool("wl-paste"):
        return None
    try:
        r = subprocess.run([wl_tool("wl-paste"), "--no-newline", "--type", "text"], capture_output=True,
                           env=dict(os.environ, WAYLAND_DISPLAY=sock), timeout=5)
    except (OSError, subprocess.TimeoutExpired):      # (a clipboard owner that doesn't answer: no text)
        return None
    text = r.stdout.decode(errors="replace").strip() if r.returncode == 0 else ""
    return text or None


