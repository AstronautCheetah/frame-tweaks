def ocr(img):
    """Text in the image (Tesseract), or None if Tesseract isn't installed."""
    if not Path(TESSERACT).exists():
        return None
    with tempfile.TemporaryDirectory() as t:
        path = Path(t) / "snip.png"
        # Small screen text reads better at 2x.
        img.scaled(img.width() * 2, img.height() * 2, Qt.AspectRatioMode.KeepAspectRatio,
                   Qt.TransformationMode.SmoothTransformation).save(str(path))
        r = subprocess.run([TESSERACT, str(path), "-", "--psm", "3"], capture_output=True, text=True)
    text = re.sub(r"[ \t]+\n", "\n", r.stdout).strip()
    return re.sub(r"\n{3,}", "\n\n", text)


