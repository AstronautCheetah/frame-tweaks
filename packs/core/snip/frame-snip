def set_stream_volume(name, volume):
    """The volume of the part playing now (pw-play's stream, named after its file), at once:
    through PipeWire's PulseAudio side (pactl). Without pactl, or if it's gone, the next part has it."""
    try:
        out = subprocess.run([PACTL, "-f", "json", "list", "sink-inputs"], capture_output=True, text=True, timeout=3).stdout
        for stream in json.loads(out or "[]"):
            if stream.get("properties", {}).get("media.name") == name:
                subprocess.run([PACTL, "set-sink-input-volume", str(stream["index"]), f"{volume:.2f}"],
                               capture_output=True, timeout=3)
    except (OSError, ValueError, TypeError, KeyError, subprocess.SubprocessError):
        pass


def sentences(text):
    """Speakable chunks: sentences, long ones split at commas, short ones joined."""
    parts = [p.strip() for p in re.split(r"(?<=[.!?:;])\s+|\n{2,}", text.replace("\r", "")) if p.strip()]
    out = []
    for part in parts:
        part = re.sub(r"\s+", " ", part)
        while len(part) > 300:                              # very long: break at a comma or space
            cut = max(part.rfind(", ", 0, 300), part.rfind(" ", 0, 300))
            cut = cut if cut > 100 else 300
            out.append(part[:cut + 1].strip())
            part = part[cut + 1:].strip()
        if out and len(out[-1]) < 40:
            out[-1] = f"{out[-1]} {part}"
        else:
            out.append(part)
    return out


class Narrator(QObject):
    """Reads text aloud with Piper, a sentence at a time (the next one is prepared while one plays),
    so it starts quickly and a speed change applies at once (the current sentence restarts).
    Previous / Next (skip) move a whole part, playing or paused. A part the Speech engine fails
    to make (it doesn't start, or ends without the sound) is tried once more; then it stops there
    and says why (failed), rather than trying again and again."""
    progress = pyqtSignal(int, int)          # sentence index, count (also while paused there)
    finished = pyqtSignal()
    failed = pyqtSignal(str, int)            # why (English, N_), the part's index: stopped there
    TRIES = 2

    def __init__(self, text, speed, volume=1.0):
        super().__init__()
        self.parts, self.speed, self.volume = sentences(text), speed, volume
        self.dir = Path(tempfile.mkdtemp(prefix="snip-narrate-"))
        self.wavs = {}                       # index -> (speed, path) synthesized
        self.synth = None                    # (index, speed, QProcess) being synthesized
        self.failures = {}                   # index -> times the Speech engine failed to make it
        self.why = None                      # what went wrong the last time
        self.player = None
        self.i = 0
        self.stopped = False
        self.paused = False

    def start(self):
        self._synth(self.i)

    def _synth(self, i):
        if (self.stopped or i >= len(self.parts) or self.synth or self.failures.get(i, 0) >= self.TRIES
                or (i in self.wavs and self.wavs[i][0] == self.speed)):
            return
        out = self.dir / f"{i}-{self.speed}.wav"
        proc = QProcess(self)
        speed = self.speed
        self.synth = (i, speed, proc)        # (before it starts: one that can't start says so)
        proc.finished.connect(lambda *_: self._synthesized(i, speed, out, proc))
        # One that can't start (Piper gone, say) never finishes: that's a failure too.
        proc.errorOccurred.connect(lambda e: e == QProcess.ProcessError.FailedToStart
                                   and self._synthesized(i, speed, out, proc, started=False))
        conf = narrate_conf()
        if conf.get("engine") == "espeak-ng" and ESPEAK.exists():
            env = QProcessEnvironment.systemEnvironment()
            env.insert("LD_LIBRARY_PATH", str(ESPEAK.parent))
            env.insert("ESPEAK_DATA_PATH", str(ESPEAK.parent))
            proc.setProcessEnvironment(env)
            proc.start(str(ESPEAK), ["-v", conf.get("espeak_voice") or "en-us", "-s", str(round(175 * speed)),
                                     "-w", str(out), "--stdin"])
        else:
            proc.start(str(PIPER), ["--model", str(VOICE), "--config", f"{VOICE}.json", "--output_file", str(out),
                                    "--length_scale", f"{1 / speed:.3f}"])
        proc.write(self.parts[i].encode())
        proc.closeWriteChannel()

    def _synthesized(self, i, speed, out, proc, started=True):
        if self.synth is None or self.synth[2] is not proc:
            return                           # (already done with)
        self.synth = None
        proc.deleteLater()
        if self.stopped:
            return
        if not (started and proc.exitStatus() == QProcess.ExitStatus.NormalExit and proc.exitCode() == 0
                and out.is_file() and out.stat().st_size):
            self.failures[i] = self.failures.get(i, 0) + 1       # (tried again, up to TRIES: _play)
            self.why = (N_("The Speech engine failed to read part {part}.") if started
                        else N_("The Speech engine didn't start: reinstall it in Frame Tweaks."))
        elif speed == self.speed:
            self.wavs[i] = (speed, out)
        if self.player is None:
            self._play()
        self._synth(self.i + 1 if self.player is not None else self.i)

    def _play(self):
        if self.stopped:
            return
        if self.i >= len(self.parts):        # read to the end (before Pause: one pressed as the last
            self.paused = False              # part ended isn't left standing, Stop then reading it again)
            self.finished.emit()
            return
        self.progress.emit(self.i, len(self.parts))    # where it is, even before it plays (Previous / Next count from it)
        if self.paused:
            return
        w = self.wavs.get(self.i)
        if not w or w[0] != self.speed:
            if self.failures.get(self.i, 0) >= self.TRIES:
                self.stop()                  # the Speech engine can't make this part: stop here, saying why
                self.failed.emit(self.why, self.i)
            else:
                self._synth(self.i)          # not ready yet: plays when it is
            return
        self.player = QProcess(self)
        self.player.finished.connect(self._played)
        self.playing = str(w[1])
        self.player.start("pw-play", ["--volume", f"{self.volume:.2f}", self.playing])
        self._synth(self.i + 1)

    def _played(self, *_):
        if self.player:
            self.player.deleteLater()
        self.player = None
        if self.stopped:
            return
        self.i += 1
        self._play()

    def _drop_player(self):
        """Stop the sound playing, without moving on (_played isn't called)."""
        if self.player:
            p, self.player = self.player, None
            if self.paused and p.processId():
                os.kill(p.processId(), signal.SIGCONT)            # a stopped process can't be killed cleanly
            p.finished.disconnect()
            p.kill()
            p.waitForFinished(500)
            p.deleteLater()

    def set_speed(self, speed):
        """New speed: the current sentence starts again at it."""
        self.speed = speed
        self._drop_player()
        self._play()

    def set_volume(self, volume):
        """New volume: the part playing changes at once (off the window's thread: pactl), the next
        ones start at it."""
        self.volume = volume
        if self.player is not None:
            threading.Thread(target=set_stream_volume, args=(self.playing, volume), daemon=True).start()

    def skip(self, d):
        """Previous (-1) / Next (1): the start of that part, at once. Paused, it stays paused there
        (that part is prepared, and Resume starts it). Nothing before the first or after the last."""
        i = self.i + d
        if self.stopped or not 0 <= i < len(self.parts):
            return
        self.i = i
        self._drop_player()
        self._play()
        if self.paused:
            self._synth(i)

    def again(self):
        self.stopped, self.paused, self.i = False, False, 0
        self.failures.clear()                # (a part that failed is tried again)
        self._play()

    def pause(self):
        """Freeze the sound where it is (the player is suspended, so Resume carries on mid-word)."""
        self.paused = True
        if self.player and self.player.processId():
            os.kill(self.player.processId(), signal.SIGSTOP)

    def resume(self):
        self.paused = False
        if self.player and self.player.processId():
            os.kill(self.player.processId(), signal.SIGCONT)
        elif self.player is None:
            self._play()

    def stop(self):
        self.stopped = True
        if self.paused and self.player and self.player.processId():
            os.kill(self.player.processId(), signal.SIGCONT)      # a stopped process can't be killed cleanly
        self.paused = False
        for p in (self.player, self.synth[2] if self.synth else None):
            if p is not None:
                p.kill()
                p.waitForFinished(500)

    def cleanup(self):
        self.stop()
        shutil.rmtree(self.dir, ignore_errors=True)


SPEECH_CONF = HOME / ".config/frame-tweaks/speech.conf"


def speech_settings():
    """(engine, language) from speech.conf, as the Speech engine reads them."""
    conf = {"SPEECH_ENGINE": "piper", "SPEECH_LANGUAGE": "en_US", **ftconf.read_shell(SPEECH_CONF)}
    return conf["SPEECH_ENGINE"], conf["SPEECH_LANGUAGE"]


def save_speech_setting(key, value):
    """One KEY=value line in speech.conf (other lines kept)."""
    ftconf.set_shell(SPEECH_CONF, {key: value})


