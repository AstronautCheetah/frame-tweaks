def nested_wayland():
    """The desktop's Wayland socket (wl-copy talks to it from any session)."""
    for s in [RUN / "nested_plasma/wayland-0", *RUN.glob("*/wayland-0"), RUN / "wayland-0"]:
        if s.is_socket():
            return str(s)
    return None


def wl_tool(name):
    """wl-copy / wl-paste: on PATH, or Homebrew's (not always on a launcher's PATH)."""
    return shutil.which(name) or next((p for p in ("/home/linuxbrew/.linuxbrew/bin/" + name,) if os.path.exists(p)), None)


def to_clipboard(data, mime):
    sock = nested_wayland()
    if not sock or not wl_tool("wl-copy"):
        return False
    env = dict(os.environ, WAYLAND_DISPLAY=sock)
    p = subprocess.Popen([wl_tool("wl-copy"), "--type", mime], stdin=subprocess.PIPE, env=env, start_new_session=True)
    p.communicate(data)
    return p.returncode == 0


