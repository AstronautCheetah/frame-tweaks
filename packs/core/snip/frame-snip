            w.setStyleSheet("QPushButton { padding: 12px 14px; font-size: 20px; }"
                            " QPushButton:checked { background: #355b7a; font-weight: 700; }")

    @staticmethod
    def heading(text):
        h = tr_text(QLabel(), text)
        h.setStyleSheet("color: #9aa6b2; font-size: 18px; margin-top: 10px;")
        return h

    def choice(self, key, value, label):
        b = QPushButton(label)
        b.setCheckable(True)
        b.clicked.connect(lambda: self.pick(key, value))
        self.buttons[(key, value)] = b
        return b

    def refresh(self):
        engine, lang = speech_settings()
        for (key, value), b in self.buttons.items():
            b.setChecked(value == (engine if key == "SPEECH_ENGINE" else lang))
        tr_text(self.state, N_("Changes apply when you press Apply."))

    def pick(self, key, value):
        save_speech_setting(key, value)
        self.refresh()

    def run_apply(self):
        apply_cmd = DATA / "apply"
        if not apply_cmd.exists():
            tr_text(self.state, N_("Reinstall the Speech engine in Frame Tweaks first."))
            return
        self.apply.setEnabled(False)
        tr_text(self.state, N_("Applying… (a new language downloads its voice, about 60 MB)"))
        proc = QProcess(self)
        proc.setProcessChannelMode(QProcess.ProcessChannelMode.MergedChannels)

        def done(*_args):
            out = [re.sub(r"\x1b\[[0-9;]*m", "", l).strip() for l in bytes(proc.readAll()).decode(errors="replace").splitlines()]
            out = [l for l in out if l and "#" not in l[:3]]
            ok = proc.exitStatus() == QProcess.ExitStatus.NormalExit and proc.exitCode() == 0
            msg = out[-1].removeprefix("==> ") if out else _("Done.")
            self.state.setText(msg if ok else _("Didn't work: %s") % msg)
            self.apply.setEnabled(True)
        proc.finished.connect(done)
        proc.start(str(apply_cmd), [])
        self.proc = proc


