{
  "action_manifest_version": 0,
  "controller_type": "frame_controller",
  "name": "Arrow Pad haptics",
  "description": "Hover and press feedback for Frame Tweaks Arrow Pad",
  "bindings": {
    "/actions/arrowpad": {
      "haptics": [
        { "output": "/actions/arrowpad/out/haptic_left", "path": "/user/hand/left/output/haptic" },
        { "output": "/actions/arrowpad/out/haptic_right", "path": "/user/hand/right/output/haptic" }
      ]
    }
  }
}
