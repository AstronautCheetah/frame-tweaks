#!/usr/bin/env python3
"""wallet-launcher: make apps use the ONE KDE wallet shared by both Frame sessions.

The Frame runs two sessions: Steam/VR on the outer D-Bus (/run/user/$UID/bus)
and the nested Plasma desktop on a private bus. An app started from the desktop
talks to a second kwalletd6 on the private bus; secrets it stores there are
invisible to the same app in VR, and two daemons writing one wallet file can
overwrite each other's changes.

This writes a launcher override into ~/.local/share/applications that starts
the app on the outer bus (and, for Flatpaks, lets it talk to the wallet), so
every launch, from the desktop menu or the VR "+" menu, uses the same wallet.
Approach from lhns/steam-frame-nix (docs/launchers.md, `keyring.enable`).

  wallet-launcher org.signal.Signal com.anthropic.Claude   # add
  wallet-launcher --electron some.electron.App             # also --password-store=kwallet6
  wallet-launcher --gate org.mozilla.firefox               # also require the wallet password
  wallet-launcher --gate --no-shared android-mirror         # password only, keep the app's own bus
  wallet-launcher --no-gate org.mozilla.firefox            # stop requiring it (re-running without
                                                           # either keeps what the entry has)
  wallet-launcher --remove org.signal.Signal               # restore the original entry
  wallet-launcher --reapply android-mirror                  # rebuild from the original, same flags
  wallet-launcher --list
"""
import argparse
import os
import re
import shlex
import sys
from pathlib import Path

sys.path.insert(0, os.environ.get("FRAME_TWEAKS_PYLIB") or str(Path.home() / ".local/share/frame-tweaks/i18n"))   # (lib/common.sh install_i18n)
try:
    from i18n import _, N_, ngettext
except ImportError:                       # (not installed by Frame Tweaks: English)
    def _(text):
        return text

    def ngettext(singular, plural, n):
        return singular if n == 1 else plural
    N_ = _

HOME = Path.home()
APPS = HOME / ".local/share/applications"
SOURCES = [HOME / ".local/share/flatpak/exports/share/applications",
           Path("/var/lib/flatpak/exports/share/applications")]
# System apps (read-only partition): wrapped by an override of the same name in APPS, which
# --remove deletes again. Checked last.
SYSTEM_SOURCES = [Path("/usr/local/share/applications"), Path("/usr/share/applications")]
MARK = "X-FrameTweaks-Wallet"
# Outside APPS: Steam's "+" menu also lists entries in subfolders of APPS (duplicates).
BACKUP_DIR = HOME / ".local/share/frame-tweaks/launcher-originals"
OLD_BACKUP_DIR = APPS / ".wallet-launcher-originals"
WRAPPER = str(HOME / ".local/bin/frame-outer-bus")
GATE = str(HOME / ".local/bin/wallet-gate")
GUARD = str(HOME / ".local/bin/signal-guard")   # retired (app-timers + --gate); dropped on rebuild
TALK = ["--talk-name=org.kde.kwalletd6", "--talk-name=org.freedesktop.secrets"]


def source_for(app_id):
    own = APPS / f"{app_id}.desktop"
    backup = BACKUP_DIR / f"{app_id}.desktop"
    # An entry there with nothing of ours is the original (add() backs it up): a host app's own
    # (e.g. Claude Desktop), your edit of a Flatpak's or system app's, or a newer one an app's
    # installer wrote over our wrapper (then the backup is out of date).
    text = own.read_text() if own.exists() else ""
    if text and not any(w in text for w in (f"{MARK}=true", WRAPPER, GATE, GUARD)):
        return own
    if backup.exists():                       # re-run: start from the untouched original
        return backup
    for d in SOURCES:
        if (d / f"{app_id}.desktop").exists():
            return d / f"{app_id}.desktop"
    system = next((d / f"{app_id}.desktop" for d in SYSTEM_SOURCES if (d / f"{app_id}.desktop").exists()), None)
    # Ours without a backup: rebuilt from itself, but an override of a system app from the system entry.
    if own.exists() and not (system and f"{MARK}=true" in text):
        return own
    if system:
        return system
    sys.exit(_("wallet-launcher: no desktop entry found for {app_id}").format(app_id=app_id))


def rewrite_exec(cmd, app_id, electron, shared=True, gate=False):
    args = shlex.split(cmd)
    while args and args[0] in (GATE, WRAPPER, GUARD, "--"):   # re-run on an already wrapped entry
        args = args[1:]
    if (shared or electron) and len(args) > 1 and os.path.basename(args[0]) == "flatpak" and args[1] == "run":
        idx = next((i for i, a in enumerate(args) if a == app_id), None)
        if idx is None:
            sys.exit(_("wallet-launcher: can't find {app_id} in: {command}").format(app_id=app_id, command=cmd))
        extra = [t for t in TALK if t not in args] if shared else []
        args = args[:idx] + extra + [app_id] + (["--password-store=kwallet6"] if electron else []) + args[idx + 1:]
    elif electron:                            # (after env VAR=…: the program's own option)
        i = next((i for i, a in enumerate(args) if os.path.basename(a) != "env" and "=" not in a), 0)
        args = args[:i + 1] + ["--password-store=kwallet6"] + args[i + 1:]
    out = ([GATE] if gate else []) + ([WRAPPER] if shared else []) + args
    # Field codes (%U, @@u) must stay unquoted.
    return " ".join(a if re.fullmatch(r"%[a-zA-Z]|@@[a-z]?", a) else shlex.quote(a) for a in out)


# Electron apps that read the wallet only when told the password store explicitly. Without it,
# Claude Desktop ran with "safeStorage not available": no saved login, secrets in plain text.
KNOWN_ELECTRON = {"com.anthropic.Claude"}


def add(app_id, electron, shared=True, gate=None):
    """gate: True/False to set it, None to keep what the current entry has (re-wrapping after an
    app update, or another tweak adding its app, must not silently drop the password gate)."""
    src = source_for(app_id)
    lines = src.read_text().splitlines()
    current = APPS / f"{app_id}.desktop"
    if gate is None:
        gate = current.exists() and f"{MARK}=true" in current.read_text() and GATE in current.read_text()
    # Re-applying (e.g. after an app update) keeps --password-store, even if not asked again.
    electron = electron or app_id in KNOWN_ELECTRON or (
        current.exists() and "--password-store=kwallet6" in current.read_text())
    if src.parent == APPS and src.name == f"{app_id}.desktop":
        BACKUP_DIR.mkdir(parents=True, exist_ok=True)
        (BACKUP_DIR / src.name).write_text("\n".join(lines) + "\n")
    out = []
    for line in lines:
        if line.startswith("Exec="):
            line = "Exec=" + rewrite_exec(line[5:], app_id, electron, shared, gate)
        elif line.startswith("DBusActivatable=") and (shared or gate):
            line = "DBusActivatable=false"   # otherwise the desktop starts it over D-Bus, not Exec=
        elif line.startswith(MARK + "="):
            continue
        out.append(line)
        if line == "[Desktop Entry]":
            out.append(f"{MARK}=true")
    APPS.mkdir(parents=True, exist_ok=True)
    (APPS / f"{app_id}.desktop").write_text("\n".join(out) + "\n")
    what = [w for w, on in ((_("shared wallet"), shared), (_("password required"), gate)) if on]
    print(f"{app_id}: {', '.join(what)}")


def flags_of(app_id):
    """(shared, gate) as currently applied to app_id's entry."""
    text = (APPS / f"{app_id}.desktop").read_text()
    return WRAPPER in text, GATE in text


def migrate_backups():
    """Move backups from the old in-APPS folder (which Steam listed as extra entries)."""
    if OLD_BACKUP_DIR.is_dir():
        BACKUP_DIR.mkdir(parents=True, exist_ok=True)
        for f in OLD_BACKUP_DIR.glob("*.desktop"):
            if not (BACKUP_DIR / f.name).exists():
                f.replace(BACKUP_DIR / f.name)
            else:
                f.unlink()
        OLD_BACKUP_DIR.rmdir()


def remove(app_id):
    target, backup = APPS / f"{app_id}.desktop", BACKUP_DIR / f"{app_id}.desktop"
    if backup.exists():
        backup.replace(target)
    elif target.exists() and f"{MARK}=true" in target.read_text():
        target.unlink()
    else:
        print(_("{app_id}: no wallet launcher").format(app_id=app_id)); return
    print(_("{app_id}: original launcher restored").format(app_id=app_id))


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("apps", nargs="*")
    ap.add_argument("--electron", action="store_true", help=_("also pass --password-store=kwallet6"))
    ap.add_argument("--no-gate", action="store_true", help=_("stop requiring the wallet password"))
    ap.add_argument("--gate", action="store_true",
                    help=_("require the wallet password (wallet-unlock) before starting the app"))
    ap.add_argument("--no-shared", action="store_true",
                    help=_("don't move the app to the outer bus (for apps that don't use the wallet)"))
    ap.add_argument("--remove", action="store_true")
    ap.add_argument("--list", action="store_true")
    ap.add_argument("--reapply", action="store_true",
                    help=_("rebuild the wrapper from the (updated) original, keeping its flags"))
    a = ap.parse_args()
    migrate_backups()
    if a.list:
        for f in sorted(APPS.glob("*.desktop")):
            text = f.read_text()
            if f"{MARK}=true" in text:
                flags = [w for w, t in (("shared", WRAPPER), ("gate", GATE)) if t in text]
                print(f"{f.stem:28} {' '.join(flags)}")
        return
    if not a.apps:
        ap.error(_("give at least one app ID"))
    for app in a.apps:
        if a.remove:
            remove(app)
        elif a.reapply:
            current = APPS / f"{app}.desktop"
            if not (current.exists() and f"{MARK}=true" in current.read_text()):
                remove(app)          # no wrapper left to rebuild (its app was removed): the original goes back
                continue
            shared, gate = flags_of(app)
            add(app, "--password-store=kwallet6" in current.read_text(), shared, gate)
        else:
            add(app, a.electron, not a.no_shared, True if a.gate else False if a.no_gate else None)
    os.system("update-desktop-database -q ~/.local/share/applications 2>/dev/null")
    os.utime(APPS)   # Steam's "+" menu rescans when this directory's mtime changes


if __name__ == "__main__":
    main()
