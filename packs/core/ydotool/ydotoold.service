[Unit]
Description=ydotool daemon (virtual keyboard used by dictation and arrowpad)
# A crash loop gives up: 10 starts within 5 minutes and it stays stopped, rather than restart
# for ever; running steadily, old starts age out. (systemd's own limit, 5 in 10 s, would never
# trip with the growing waits below.)
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
ExecStart=%h/.local/bin/ydotoold --socket-path=/run/user/%U/.ydotool_socket --socket-own=%U:%G
# On a crash only (not a clean exit, nor a stop by Frame Tweaks): again after 1 s, the wait
# doubling with each restart up to 32 s (systemd 254+; the Frame has 257).
Restart=on-failure
RestartSec=1
RestartSteps=5
RestartMaxDelaySec=32
# Sandboxing: it only needs /dev/uinput and its socket in /run/user/<uid>.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%t
PrivateTmp=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=default.target
