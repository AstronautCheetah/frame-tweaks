# Copy to ~/.config/frame-tweaks/dictate.conf to customise dictation.
# Words Whisper should spell your way (names, jargon):
#DICTATE_PROMPT="SteamOS, Steam Frame, SteamVR, KDE Plasma."
# Language spoken (the shared model is multilingual), e.g. de, fr, es; "auto" to detect:
#DICTATE_LANG=en
# A different whisper.cpp model:
#DICTATE_MODEL="$HOME/.local/share/whisper/ggml-base.en-q5_1.bin"
# Only copy to the clipboard, don't type into the focused window:
#DICTATE_NOTYPE=1
# Stop a recording you forgot after this many seconds:
#DICTATE_MAX_SECONDS=300
# The controller button that toggles dictation when you hold it, in VR: menu (on the right
# controller; the default), y, or off. How long to hold it, in seconds:
#DICTATE_BUTTON=menu
#DICTATE_BUTTON_HOLD=0.6
