#!/usr/bin/env python3
"""dictate-parakeet: Dictation's Parakeet engine, NVIDIA's Parakeet TDT 0.6B v3 (int8) through onnx-asr,
on the CPU. It punctuates and capitalises, and tells the 25 European languages it knows apart by itself.

  dictate-parakeet FILE.wav      print what was said (16 kHz mono, as dictate records)
  dictate-parakeet --serve PORT  keep the model loaded and answer on 127.0.0.1:PORT, as whisper-server
                                 does: POST /inference with the recording as the form's "file" (its
                                 other fields are Whisper's, and ignored); GET / answers once loaded

Installed (on its own venv, ~/.local/share/frame-tweaks/parakeet/venv) by Dictation's ⚙ Settings,
Apply, when Parakeet is chosen; the model files are checksum-pinned (dictation/parakeet-*.pin)."""
import email.parser
import email.policy
import http.server
import io
import os
import sys
import wave
from pathlib import Path

MODEL = Path(os.environ.get("FRAME_TWEAKS_PARAKEET_MODEL")
             or Path.home() / ".local/share/frame-tweaks/parakeet/model")
THREADS = 6                     # (dictate runs it on the Frame's six fast cores: taskset -c 2-7)
MAX_BODY = 64 << 20             # (dictate's longest recording, 300 s at 16 kHz, is under 10 MB)


def load():
    import numpy  # noqa: F401   (onnx-asr's; imported here so a broken venv fails before the model loads)
    import onnx_asr
    import onnxruntime as rt
    opts = rt.SessionOptions()
    opts.intra_op_num_threads = THREADS
    return onnx_asr.load_model("nemo-parakeet-tdt-0.6b-v3", MODEL, quantization="int8", sess_options=opts)


def samples(data):
    """A WAV file's samples as float32 in -1..1 (16-bit PCM, mono, 16 kHz: what dictate records)."""
    import numpy as np
    with wave.open(io.BytesIO(data)) as w:
        if w.getsampwidth() != 2 or w.getnchannels() != 1 or w.getframerate() != 16000:
            raise ValueError("expected 16-bit mono 16 kHz WAV")
        return np.frombuffer(w.readframes(w.getnframes()), dtype="<i2").astype(np.float32) / 32768


def form_file(content_type, body):
    """The "file" part of a multipart/form-data body (what curl -F sends), or None."""
    msg = email.parser.BytesParser(policy=email.policy.HTTP).parsebytes(
        b"Content-Type: " + content_type.encode() + b"\r\n\r\n" + body)
    if not msg.is_multipart():
        return None
    for part in msg.iter_parts():
        if part.get_param("name", header="content-disposition") == "file":
            return part.get_payload(decode=True)
    return None


def serve(port):
    model = load()

    class Handler(http.server.BaseHTTPRequestHandler):
        def reply(self, code, text):
            out = text.encode()
            self.send_response(code)
            self.send_header("Content-Type", "text/plain; charset=utf-8")
            self.send_header("Content-Length", str(len(out)))
            self.end_headers()
            self.wfile.write(out)

        def do_GET(self):          # noqa: N802   (http.server's name)
            self.reply(200, "parakeet\n")

        def do_POST(self):         # noqa: N802
            if self.path != "/inference":
                return self.reply(404, "not found\n")
            n = int(self.headers.get("Content-Length") or 0)
            if not 0 < n <= MAX_BODY:
                return self.reply(413, "too large\n")
            try:
                data = form_file(self.headers.get("Content-Type", ""), self.rfile.read(n))
                if data is None:
                    return self.reply(400, "no file\n")
                text = model.recognize(samples(data))
            except Exception as e:  # noqa: BLE001   (one bad request mustn't end the loaded engine)
                return self.reply(400, f"{e}\n")
            self.reply(200, text.strip() + "\n")

        def log_message(self, *_):  # (nothing said goes to the journal)
            pass

    http.server.HTTPServer(("127.0.0.1", port), Handler).serve_forever()


def main(a):
    if len(a) == 2 and a[0] == "--serve" and a[1].isdigit():
        serve(int(a[1]))
    elif len(a) == 1 and not a[0].startswith("-"):
        print(load().recognize(samples(Path(a[0]).read_bytes())).strip())
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main(sys.argv[1:])
