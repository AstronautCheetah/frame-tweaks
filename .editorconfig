# The repo's existing style, for editors that read EditorConfig (https://editorconfig.org).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,json,yml,yaml,md}]
indent_size = 2

# A patch's trailing spaces are part of its content.
[*.patch]
trim_trailing_whitespace = false
